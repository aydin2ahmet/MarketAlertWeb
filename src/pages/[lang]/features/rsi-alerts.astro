---
import Base from '../../../layouts/Base.astro';
import content from '../../../i18n/content.json';
import guides from '../../../i18n/rsi-alerts.json';
import walkthroughs from '../../../i18n/rsi-walkthrough.json';
import screenSizes from '../../../i18n/rsi-screens.json';
import { GA_ID, LOCALES, SITE, legalUrl } from '../../../config';

export function getStaticPaths() {
  return LOCALES.map(locale => ({ params: { lang: locale.code }, props: { locale } }));
}
const { locale } = Astro.props;
const code = locale.code;
const t = (content as any)[code];
const g = (guides as any)[code];
const w = (walkthroughs as any)[code];
const sizes = (screenSizes as any)[code];
const path = `/${code}/features/rsi-alerts/`;
const alternates = LOCALES.map(l => ({ hreflang: l.hreflang, href: `/${l.code}/features/rsi-alerts/` }));
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: g.title, description: g.description, url: SITE + path, inLanguage: locale.hreflang },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'MarketAlert', item: `${SITE}/${code}/` },
    { '@type': 'ListItem', position: 2, name: g.link, item: SITE + path },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: locale.hreflang, mainEntity: g.faq.map((q: string[]) => ({ '@type': 'Question', name: q[0], acceptedAnswer: { '@type': 'Answer', text: q[1] } })) },
];
---
<Base lang={code === 'pt-br' ? 'pt-BR' : code} dir={locale.dir} title={g.title} description={g.description} path={path} ogImage={`/og/${code}.png`} jsonLd={jsonLd} alternates={alternates}>
  <a class="skip" href="#setup">{g.stepsTitle}</a>
  <header class="hd">
    <a class="logo" href={`/${code}/`}><img src="/icons/logo-96.png" alt="" width="32" height="32" /><b>MarketAlert</b></a>
    <nav aria-label="MarketAlert"><a href={`/${code}/#features`}>{t.nav[0]}</a><a href="#plans">{t.nav[2]}</a><a href="#faq">{t.nav[3]}</a></nav>
    <div class="hx">
      <label class="lsel"><span class="skip">{t.ui.lang}</span><select id="lang" aria-label={t.ui.lang}>{LOCALES.map(l => <option value={l.code} selected={l.code === code} lang={l.hreflang}>{l.name}</option>)}</select></label>
      <button class="thm" id="theme" type="button" aria-label={t.ui.theme} title={t.ui.theme}>
        <svg class="ic i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 14.5A8 8 0 019.5 4 8 8 0 1020 14.5z" /></svg>
        <svg class="ic i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
      <a class="btn" href={`/${code}/#download`} data-ev="cta_click">{t.download}</a>
    </div>
  </header>
  <main class="rsi-guide">
    <nav class="breadcrumbs" aria-label="MarketAlert"><a href={`/${code}/`}>MarketAlert</a><span aria-hidden="true"> / </span><span>{g.link}</span></nav>
    <section class="guide-hero">
      <div><p class="guide-kicker">{g.kicker}</p><h1>{g.h1}</h1><p class="guide-intro">{g.intro}</p><a class="btn" href="#setup">{g.stepsTitle}<span aria-hidden="true"> ↓</span></a></div>
      <figure><div class="pf guide-phone"><img class="sh-l" src={`/shots/${code}/light/hero-list.webp`} alt={t.heroListAlt} width="360" height="940" fetchpriority="high" decoding="async" /><img class="sh-d" src={`/shots/${code}/dark/hero-list.webp`} alt="" width="360" height="940" loading="lazy" decoding="async" /></div><figcaption>{g.caption}</figcaption></figure>
    </section>
    <section class="voice-example" aria-labelledby="example-title">
      <div><p class="guide-kicker">RSI(14) &lt; 30 · 1h · TOP 100</p><h2 id="example-title">{g.exampleTitle}</h2><blockquote><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3" /><path d="M5 10v2a7 7 0 0014 0v-2M12 19v3M8 22h8" /></svg><p>{w.message}</p></blockquote><p class="example-note">{g.exampleNote}</p></div>
      <dl>{g.specs.map((row: string[], i: number) => <div><dt>{row[0]}</dt><dd>{i === 2 ? `${w.rsi} ∧ ${w.ema}` : row[1]}</dd></div>)}</dl>
    </section>
    <section id="setup" class="rsi-walkthrough">
      <div class="walk-heading"><p class="walk-kicker">{w.kicker}</p><h2>{g.stepsTitle}</h2><p>{w.intro}</p></div>
      <div class="walk-tabs" role="tablist" aria-label={g.stepsTitle}>
        {['voice', 'chat'].map((flow, i) => <button id={`${flow}-tab`} type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`${flow}-panel`} data-flow={flow} tabindex={i === 0 ? 0 : -1}>{w.tabs[i]}</button>)}
      </div>
      {['voice', 'chat'].map((flow, index) => {
        const steps = w[flow];
        const desktopShots = [flow === 'voice' ? 'voice-say' : 'chat-write', flow === 'voice' ? 'desktop-voice-result' : 'desktop-chat-draft', 'list'];
        const desktopTitles = [w.desktop[index], w.desktop[index + 2], w.desktop[4]];
        const mobileShots = flow === 'voice' ? ['voice-open', 'voice-say', 'voice-result', 'list'] : ['chat-open', 'chat-write', 'chat-draft', 'list'];
        return <div id={`${flow}-panel`} role="tabpanel" aria-labelledby={`${flow}-tab`} hidden={index !== 0}>
          <p class="walk-note">{w.notes[index]}</p>
          <div class="desktop-scene">
            <div class="scene-context"><span>RSI + EMA</span><span>{g.specs[1][1]}</span><span>Telegram</span></div>
            <div class="scene-three">
              {desktopShots.map((kind, i) => <article class="scene-part">
                <div class="scene-label"><span class="scene-number">{['01–02', '03', '04'][i]}</span><h3>{desktopTitles[i]}</h3><p>{w.short[i]}</p></div>
                <figure>
                  <img class="sh-l" src={`/shots/${code}/light/rsi/${kind}.webp`} alt={`${desktopTitles[i]} · ${w.alertTitle}`} width="390" height={sizes.light[kind]} loading="lazy" decoding="async" />
                  <img class="sh-d" src={`/shots/${code}/dark/rsi/${kind}.webp`} alt={`${desktopTitles[i]} · ${w.alertTitle}`} width="390" height={sizes.dark[kind]} loading="lazy" decoding="async" />
                </figure>
              </article>)}
              <svg class="scene-thread" viewBox="0 0 1100 650" fill="none" preserveAspectRatio="none" aria-hidden="true"><path class="thread-glow" d="M40 450 C160 650 330 640 400 340 S690 50 755 320 S940 650 1080 470" /><path d="M40 450 C160 650 330 640 400 340 S690 50 755 320 S940 650 1080 470" /><path class="thread-tip" d="M365 415 L390 387 L402 423 M718 239 L744 264 L752 230" /></svg>
            </div>
          </div>
          <ol class="walk-grid">
            {mobileShots.map((kind, i) => <li class="walk-card">
              <div class="walk-copy"><span class="walk-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><div><h3>{steps[i][0]}</h3><p>{steps[i][1]}</p></div></div>
              <figure class="walk-screen">
                <img class="sh-l" src={`/shots/${code}/light/rsi/${kind}.webp`} alt={`${steps[i][0]} · ${w.alertTitle}`} width="390" height={sizes.light[kind]} loading="lazy" decoding="async" />
                <img class="sh-d" src={`/shots/${code}/dark/rsi/${kind}.webp`} alt={`${steps[i][0]} · ${w.alertTitle}`} width="390" height={sizes.dark[kind]} loading="lazy" decoding="async" />
              </figure>
              <svg class="walk-arrow" viewBox="0 0 100 100" fill="none" aria-hidden="true"><path d="M8 16 C88 10 94 80 24 88" /><path d="M38 75 L23 88 L40 97" /></svg>
            </li>)}
          </ol>
        </div>;
      })}
      <p class="walk-caption">{w.caption}</p>
    </section>
    <section class="guide-section text-section"><h2>{g.scopeTitle}</h2>{g.scope.map((p: string) => <p>{p}</p>)}</section>
    <section class="guide-section text-section"><h2>{g.combineTitle}</h2><p>{g.combine}</p><div class="condition-example" dir="ltr"><span>RSI(14) &lt; 30</span><b>AND</b><span>VOL &gt; 3 × SMA(20)</span></div></section>
    <section id="plans" class="guide-section"><h2>{g.plansTitle}</h2><div class="guide-plans">{g.plans.map((p: string[]) => <article><h3>{p[0]}</h3><p>{p[1]}</p></article>)}</div><a class="text-link" href={`/${code}/#plans`}>{g.plansLink} <span aria-hidden="true">↗</span></a></section>
    <section id="faq" class="guide-section"><h2>{g.faqTitle}</h2><div class="faq">{g.faq.map((q: string[], i: number) => <details open={i === 0}><summary>{q[0]}</summary><p>{q[1]}</p></details>)}</div></section>
    <section class="guide-cta"><h2>{g.ctaTitle}</h2><p>{g.cta}</p><a class="btn" href={`/${code}/#download`} data-ev="cta_click">{g.home} <span aria-hidden="true">↗</span></a></section>
  </main>
  <footer class="ft"><div class="ftop"><a class="logo" href={`/${code}/`}><img src="/icons/logo-96.png" alt="" width="32" height="32" /><b>MarketAlert</b></a><nav class="legal"><a href={legalUrl('privacy', code)}>{t.legal[0]}</a><a href={legalUrl('terms', code)}>{t.legal[1]}</a>{GA_ID && <button type="button" class="lnk" data-consent-open>{t.consent.prefs}</button>}</nav></div><nav class="langs" aria-label={t.ui.lang}>{LOCALES.map(l => <a href={`/${l.code}/features/rsi-alerts/`} hreflang={l.hreflang} lang={l.hreflang} aria-current={l.code === code ? 'page' : undefined} data-ev="language_switch" data-to={l.code}>{l.name}</a>)}</nav><p class="disc">{t.disclaimer}</p><p class="copy">© 2026 MarketAlert · marketalertapp.com</p></footer>
  <script>
    const flowTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-flow]'));
    function selectFlow(tab: HTMLButtonElement) {
      flowTabs.forEach(button => {
        const active = button === tab;
        button.setAttribute('aria-selected', String(active));
        button.tabIndex = active ? 0 : -1;
        const panel = document.getElementById(`${button.dataset.flow}-panel`);
        if (panel) panel.hidden = !active;
      });
      (window as any).maTrack?.('walkthrough_method_change', { method: tab.dataset.flow });
    }
    flowTabs.forEach(tab => {
      tab.addEventListener('click', () => selectFlow(tab));
      tab.addEventListener('keydown', event => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === 'Home' ? flowTabs[0] : event.key === 'End' ? flowTabs[flowTabs.length - 1] : flowTabs.find(button => button !== tab);
        if (next) { selectFlow(next); next.focus(); }
      });
    });
    const root = document.documentElement;
    document.getElementById('theme')?.addEventListener('click', () => {
      const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      root.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('theme', root.dataset.theme); } catch (e) { /* depolama kapalı olabilir */ }
      (window as any).maTrack?.('theme_toggle', { theme: root.dataset.theme });
    });
    document.getElementById('lang')?.addEventListener('change', e => {
      const code = (e.target as HTMLSelectElement).value;
      (window as any).maTrack?.('language_switch', { to_lang: code });
      location.href = `/${code}/features/rsi-alerts/` + location.hash;
    });
  </script>
</Base>

<style>
  .rsi-guide { max-width: 1200px; padding: 28px 20px 0; margin-inline: auto; }
  .breadcrumbs { font-size: 13px; color: var(--mut); display: flex; flex-wrap: wrap; gap: 8px; }
  .breadcrumbs a:hover, .text-link:hover { text-decoration: underline; }
  .guide-hero { display: grid; grid-template-columns: 1fr 290px; gap: 80px; align-items: center; padding: 48px 0 64px; }
  .guide-kicker { font: 600 12px/1.6 var(--mono); color: var(--cat3); margin-bottom: 16px; }
  h1 { font-size: clamp(34px, 4.2vw, 54px); max-width: 780px; text-wrap: balance; }
  .guide-intro { font-size: 18px; color: var(--mut); margin: 24px 0; max-width: 740px; }
  figure { margin: 0; }
  .guide-phone { --pw: 250px; margin-inline: auto; }
  .guide-phone img { aspect-ratio: 360/940; object-fit: contain; }
  figcaption { color: var(--mut); font-size: 11px; text-align: center; margin-top: 14px; }
  h2 { font-size: clamp(25px, 3vw, 34px); margin-bottom: 20px; text-wrap: balance; }
  h3 { font-size: 19px; margin-bottom: 10px; }
  .voice-example { display: grid; grid-template-columns: 1.3fr 1fr; gap: 40px; padding: 32px; background: var(--sf); border: 1px solid var(--bd); border-radius: 20px; }
  blockquote { display: flex; align-items: start; gap: 12px; margin: 0; padding: 20px; border-radius: 14px; background: var(--priSoft); color: var(--tx); font-size: 19px; font-weight: 600; }
  blockquote svg { width: 22px; height: 24px; flex: none; color: var(--pri); }
  .example-note { color: var(--mut); font-size: 13px; margin-top: 16px; }
  dl { margin: 0; align-self: center; }
  dl div { padding: 14px 0; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 18px; border-bottom: 1px solid var(--bd); }
  dt { color: var(--mut); } dd { margin: 0; font-weight: 650; }
  .guide-section { padding: 64px 0; border-bottom: 1px solid var(--bd); scroll-margin-top: 90px; }
  .setup-steps { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .setup-steps li { display: flex; align-items: start; gap: 16px; padding: 24px; background: var(--sf); border: 1px solid var(--bd); border-radius: 16px; }
  .step-number { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; flex: none; background: var(--pri); color: var(--priText); font-weight: 700; }
  .setup-steps p, .text-section p, .guide-plans p { color: var(--mut); }
  .text-section p { max-width: 900px; font-size: 17px; margin-top: 16px; }
  .condition-example { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 24px; font: 600 14px/1.5 var(--mono); }
  .condition-example span { padding: 14px 18px; border-radius: 12px; background: var(--sf); border: 1px solid var(--bd); }
  .condition-example b { color: var(--cat3); }
  .guide-plans { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; }
  .guide-plans article { border: 1px solid var(--bd); border-radius: 16px; padding: 24px; background: var(--sf); }
  .text-link { display: inline-block; color: var(--cat3); font-weight: 600; margin-top: 22px; }
  .guide-cta { padding: 64px 0; text-align: center; }
  .guide-cta p { color: var(--mut); margin-bottom: 24px; }
  @media(max-width: 860px) {
    .guide-hero { grid-template-columns: 1fr; gap: 32px; padding: 32px 0 40px; }
    h1 { font-size: 34px; } .guide-intro { font-size: 17px; }
    .guide-phone { --pw: 210px; }
    .voice-example { grid-template-columns: 1fr; gap: 20px; padding: 20px; }
    blockquote { padding: 16px; font-size: 17px; }
    .guide-section { padding: 42px 0; }
    .setup-steps, .guide-plans { grid-template-columns: 1fr; gap: 16px; }
    .setup-steps li { padding: 20px; }
    dd { overflow-wrap: anywhere; }
  }

.rsi-walkthrough{padding:64px 0;border-bottom:1px solid var(--bd);scroll-margin-top:88px}.walk-heading{max-width:760px}.walk-kicker{font:600 12px/1.6 var(--mono);letter-spacing:.08em;color:var(--cat3);margin-bottom:12px}.walk-heading h2{font-size:clamp(28px,3vw,38px);margin-bottom:12px}.walk-heading p:not(.walk-kicker){color:var(--mut);font-size:17px}.walk-tabs{display:inline-flex;gap:6px;padding:5px;background:var(--sf);border:1px solid var(--bd);border-radius:14px;margin:26px 0 0}.walk-tabs button{padding:12px 24px;border:0;background:transparent;color:var(--mut);border-radius:10px;font-family:inherit;font-size:15px;font-weight:600;line-height:1.4;cursor:pointer}.walk-tabs button[aria-selected=true]{background:var(--pri);color:var(--priText);box-shadow:0 3px 10px #0001}.walk-tabs button:focus-visible{outline:3px solid var(--cat3);outline-offset:2px}.walk-note{font-size:14px;color:var(--mut);margin:16px 0 28px}.walk-grid{display:grid;grid-template-columns:1fr 1fr;list-style:none;margin:0;padding:0;gap:24px}.walk-card{border:1px solid var(--bd);background:var(--sf);border-radius:20px;overflow:hidden;display:flex;flex-direction:column}.walk-copy{display:flex;gap:16px;padding:24px;min-height:170px;align-items:start}.walk-num{flex:none;font:600 15px/1 var(--mono);color:var(--cat3);background:var(--priSoft);border:1px solid var(--bd);padding:12px 9px;border-radius:11px}.walk-copy h3{font-size:21px;line-height:1.3;margin:0 0 10px}.walk-copy p{font-size:15px;line-height:1.65;color:var(--mut);margin:0;max-width:390px}.walk-screen{margin:0;padding:20px 24px 0;background:var(--bg);border-top:1px solid var(--bd);flex:1;display:flex;align-items:flex-start;justify-content:center}.walk-screen img{width:100%;max-width:390px;height:auto;border:1px solid var(--bd);border-radius:15px 15px 0 0;box-shadow:0 12px 32px #172c4110}.walk-caption{font-size:12px;color:var(--mut);margin:18px 0 0}.rsi-walkthrough [hidden]{display:none!important}@media(max-width:700px){.rsi-walkthrough{padding:40px 0}.walk-grid{grid-template-columns:1fr;gap:20px}.walk-tabs{display:flex}.walk-tabs button{flex:1;padding:12px 14px}.walk-copy{padding:20px;min-height:0;gap:12px}.walk-copy h3{font-size:19px}.walk-copy p{font-size:14px}.walk-screen{padding:16px 12px 0}.walk-note{line-height:1.6}.walk-heading p:not(.walk-kicker){font-size:16px}.walk-kicker{font-size:10px}}

#setup .walk-grid{display:grid;position:relative;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:104px 150px;padding:28px 70px 38px;border:1px solid var(--bd);border-radius:40px;background:var(--sf)}
#setup .walk-card{position:relative;border:0;border-radius:0;background:transparent;overflow:visible;display:flex;flex-direction:column;align-items:center}
#setup .walk-card:nth-child(1){grid-area:1/1}#setup .walk-card:nth-child(2){grid-area:1/2}#setup .walk-card:nth-child(3){grid-area:2/2}#setup .walk-card:nth-child(4){grid-area:2/1}
#setup .walk-copy{display:flex;padding:0 0 22px;min-height:148px;gap:12px;width:100%;align-items:start}
#setup .walk-num{flex:none;width:36px;height:36px;padding:0;display:grid;place-items:center;border-radius:50%;background:var(--pri);color:var(--priText);border:0;font-size:13px}
#setup .walk-copy h3{font-size:21px;margin:4px 0 10px}
#setup .walk-copy p{font-size:14px;line-height:1.6}
#setup .walk-screen{padding:0;border:0;background:transparent;display:block;flex:none;width:100%;max-width:320px}
#setup .walk-screen img{width:100%;max-width:320px;border-radius:16px;box-shadow:0 8px 28px #172c4110}
#setup .walk-arrow{position:absolute;width:106px;height:106px;overflow:visible;z-index:1;color:var(--pri)}
#setup .walk-arrow path{stroke:currentColor;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}
#setup .walk-card:nth-child(1) .walk-arrow{left:calc(100% + 20px);top:60px;transform:rotate(-100deg)}
#setup .walk-card:nth-child(2) .walk-arrow{right:-80px;top:calc(100% - 12px);transform:rotate(-8deg)}
#setup .walk-card:nth-child(3) .walk-arrow{right:calc(100% + 20px);top:60px;transform:rotate(80deg)}
#setup .walk-card:nth-child(4) .walk-arrow{left:-80px;bottom:calc(100% + 8px);transform:rotate(172deg);opacity:.45}
@media(max-width:1000px) and (min-width:701px){#setup .walk-grid{gap:90px 100px;padding:28px 40px}#setup .walk-arrow{width:80px;height:80px}#setup .walk-card:nth-child(1) .walk-arrow{left:calc(100% + 10px)}#setup .walk-card:nth-child(3) .walk-arrow{right:calc(100% + 10px)}#setup .walk-copy{min-height:180px}#setup .walk-copy h3{font-size:19px}}
@media(max-width:700px){#setup .walk-grid{display:flex;flex-direction:column;gap:84px;padding:4px 0 30px;border:0;border-radius:0;background:transparent}#setup .walk-card{width:calc(100% - 44px);align-items:stretch}#setup .walk-card:nth-child(odd){align-self:flex-start}#setup .walk-card:nth-child(even){align-self:flex-end}#setup .walk-copy{padding:0 0 16px;min-height:0;gap:9px}#setup .walk-num{width:28px;height:28px;font-size:11px;margin-top:2px}#setup .walk-copy h3{font-size:18px;margin-top:3px;margin-bottom:9px}#setup .walk-copy p{font-size:14px}#setup .walk-screen{max-width:none}#setup .walk-screen img{max-width:none;border-radius:14px}#setup .walk-arrow{width:78px;height:78px}#setup .walk-card:nth-child(odd) .walk-arrow{left:auto;right:-35px;top:calc(100% + 6px);bottom:auto;transform:rotate(-12deg)}#setup .walk-card:nth-child(even) .walk-arrow{right:auto;left:-35px;top:calc(100% + 6px);bottom:auto;transform:scaleX(-1) rotate(-12deg)}#setup .walk-card:last-child .walk-arrow{display:none}}

.desktop-scene{display:none}
@media(min-width:701px){
#setup .walk-grid{display:none}
.desktop-scene{display:block;position:relative;padding:24px 26px 40px;border-radius:36px;background:radial-gradient(ellipse at 50% 60%,#ffe8b6b8 0%,#fff7e9aa 50%,var(--sf) 90%);border:1px solid var(--bd);overflow:hidden}
.scene-context{display:flex;gap:10px;justify-content:center;align-items:center;padding:0 0 26px;color:var(--mut);font:500 12px/1.4 var(--mono)}
.scene-context span+span::before{content:'·';color:var(--pri);margin-right:10px}
.scene-three{position:relative;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));align-items:start;gap:30px}
.scene-part{position:relative;z-index:2;min-width:0}
.scene-part:nth-child(1){margin-top:70px}.scene-part:nth-child(2){margin-top:0}.scene-part:nth-child(3){margin-top:70px}
.scene-label{padding:0 12px 20px;position:relative;min-height:154px}
