---
import Base from '../../../layouts/Base.astro';
import content from '../../../i18n/content.json';
import guides from '../../../i18n/rsi-alerts.json';
import { GA_ID, LOCALES, SITE, legalUrl } from '../../../config';

export function getStaticPaths() {
  return LOCALES.map(locale => ({ params: { lang: locale.code }, props: { locale } }));
}
const { locale } = Astro.props;
const code = locale.code;
const t = (content as any)[code];
const g = (guides as any)[code];
const path = `/${code}/features/rsi-alerts/`;
const alternates = LOCALES.map(l => ({ hreflang: l.hreflang, href: `/${l.code}/features/rsi-alerts/` }));
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: g.title, description: g.description, url: SITE + path, inLanguage: locale.hreflang },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'MarketAlert', item: `${SITE}/${code}/` },
    { '@type': 'ListItem', position: 2, name: g.link, item: SITE + path },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: locale.hreflang, mainEntity: g.faq.map((q: string[]) => ({ '@type': 'Question', name: q[0], acceptedAnswer: { '@type': 'Answer', text: q[1] } })) },
];
---
<Base lang={code === 'pt-br' ? 'pt-BR' : code} dir={locale.dir} title={g.title} description={g.description} path={path} ogImage={`/og/${code}.png`} jsonLd={jsonLd} alternates={alternates}>
  <a class="skip" href="#setup">{g.stepsTitle}</a>
  <header class="hd">
    <a class="logo" href={`/${code}/`}><img src="/icons/logo-96.png" alt="" width="32" height="32" /><b>MarketAlert</b></a>
    <nav aria-label="MarketAlert"><a href={`/${code}/#features`}>{t.nav[0]}</a><a href="#plans">{t.nav[2]}</a><a href="#faq">{t.nav[3]}</a></nav>
    <div class="hx">
      <label class="lsel"><span class="skip">{t.ui.lang}</span><select id="lang" aria-label={t.ui.lang}>{LOCALES.map(l => <option value={l.code} selected={l.code === code} lang={l.hreflang}>{l.name}</option>)}</select></label>
      <button class="thm" id="theme" type="button" aria-label={t.ui.theme} title={t.ui.theme}>
        <svg class="ic i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 14.5A8 8 0 019.5 4 8 8 0 1020 14.5z" /></svg>
        <svg class="ic i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
      <a class="btn" href={`/${code}/#download`} data-ev="cta_click">{t.download}</a>
    </div>
  </header>
  <main class="rsi-guide">
    <nav class="breadcrumbs" aria-label="MarketAlert"><a href={`/${code}/`}>MarketAlert</a><span aria-hidden="true"> / </span><span>{g.link}</span></nav>
    <section class="guide-hero">
      <div><p class="guide-kicker">{g.kicker}</p><h1>{g.h1}</h1><p class="guide-intro">{g.intro}</p><a class="btn" href="#setup">{g.stepsTitle}<span aria-hidden="true"> ↓</span></a></div>
      <figure><div class="pf guide-phone"><img class="sh-l" src={`/shots/${code}/light/hero-list.webp`} alt={t.heroListAlt} width="360" height="940" fetchpriority="high" decoding="async" /><img class="sh-d" src={`/shots/${code}/dark/hero-list.webp`} alt="" width="360" height="940" loading="lazy" decoding="async" /></div><figcaption>{g.caption}</figcaption></figure>
    </section>
    <section class="voice-example" aria-labelledby="example-title">
      <div><p class="guide-kicker">RSI(14) &lt; 30 · 1h · TOP 100</p><h2 id="example-title">{g.exampleTitle}</h2><blockquote><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3" /><path d="M5 10v2a7 7 0 0014 0v-2M12 19v3M8 22h8" /></svg><p>{g.example}</p></blockquote><p class="example-note">{g.exampleNote}</p></div>
      <dl>{g.specs.map((row: string[]) => <div><dt>{row[0]}</dt><dd>{row[1]}</dd></div>)}</dl>
    </section>
    <section id="setup" class="guide-section"><h2>{g.stepsTitle}</h2><ol class="setup-steps">{g.steps.map((s: string[], i: number) => <li><span class="step-number" aria-hidden="true">{i + 1}</span><div><h3>{s[0]}</h3><p>{s[1]}</p></div></li>)}</ol></section>
    <section class="guide-section text-section"><h2>{g.scopeTitle}</h2>{g.scope.map((p: string) => <p>{p}</p>)}</section>
    <section class="guide-section text-section"><h2>{g.combineTitle}</h2><p>{g.combine}</p><div class="condition-example" dir="ltr"><span>RSI(14) &lt; 30</span><b>AND</b><span>VOL &gt; 3 × SMA(20)</span></div></section>
    <section id="plans" class="guide-section"><h2>{g.plansTitle}</h2><div class="guide-plans">{g.plans.map((p: string[]) => <article><h3>{p[0]}</h3><p>{p[1]}</p></article>)}</div><a class="text-link" href={`/${code}/#plans`}>{g.plansLink} <span aria-hidden="true">↗</span></a></section>
    <section id="faq" class="guide-section"><h2>{g.faqTitle}</h2><div class="faq">{g.faq.map((q: string[], i: number) => <details open={i === 0}><summary>{q[0]}</summary><p>{q[1]}</p></details>)}</div></section>
    <section class="guide-cta"><h2>{g.ctaTitle}</h2><p>{g.cta}</p><a class="btn" href={`/${code}/#download`} data-ev="cta_click">{g.home} <span aria-hidden="true">↗</span></a></section>
  </main>
  <footer class="ft"><div class="ftop"><a class="logo" href={`/${code}/`}><img src="/icons/logo-96.png" alt="" width="32" height="32" /><b>MarketAlert</b></a><nav class="legal"><a href={legalUrl('privacy', code)}>{t.legal[0]}</a><a href={legalUrl('terms', code)}>{t.legal[1]}</a>{GA_ID && <button type="button" class="lnk" data-consent-open>{t.consent.prefs}</button>}</nav></div><nav class="langs" aria-label={t.ui.lang}>{LOCALES.map(l => <a href={`/${l.code}/features/rsi-alerts/`} hreflang={l.hreflang} lang={l.hreflang} aria-current={l.code === code ? 'page' : undefined} data-ev="language_switch" data-to={l.code}>{l.name}</a>)}</nav><p class="disc">{t.disclaimer}</p><p class="copy">© 2026 MarketAlert · marketalertapp.com</p></footer>
  <script>
    const root = document.documentElement;
    document.getElementById('theme')?.addEventListener('click', () => {
      const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      root.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('theme', root.dataset.theme); } catch (e) { /* depolama kapalı olabilir */ }
      (window as any).maTrack?.('theme_toggle', { theme: root.dataset.theme });
    });
    document.getElementById('lang')?.addEventListener('change', e => {
      const code = (e.target as HTMLSelectElement).value;
      (window as any).maTrack?.('language_switch', { to_lang: code });
      location.href = `/${code}/features/rsi-alerts/` + location.hash;
    });
  </script>
</Base>

<style>
  .rsi-guide { max-width: 1200px; padding: 28px 20px 0; margin-inline: auto; }
  .breadcrumbs { font-size: 13px; color: var(--mut); display: flex; flex-wrap: wrap; gap: 8px; }
  .breadcrumbs a:hover, .text-link:hover { text-decoration: underline; }
  .guide-hero { display: grid; grid-template-columns: 1fr 290px; gap: 80px; align-items: center; padding: 48px 0 64px; }
  .guide-kicker { font: 600 12px/1.6 var(--mono); color: var(--cat3); margin-bottom: 16px; }
  h1 { font-size: clamp(34px, 4.2vw, 54px); max-width: 780px; text-wrap: balance; }
  .guide-intro { font-size: 18px; color: var(--mut); margin: 24px 0; max-width: 740px; }
  figure { margin: 0; }
  .guide-phone { --pw: 250px; margin-inline: auto; }
  .guide-phone img { aspect-ratio: 360/940; object-fit: contain; }
  figcaption { color: var(--mut); font-size: 11px; text-align: center; margin-top: 14px; }
  h2 { font-size: clamp(25px, 3vw, 34px); margin-bottom: 20px; text-wrap: balance; }
  h3 { font-size: 19px; margin-bottom: 10px; }
  .voice-example { display: grid; grid-template-columns: 1.3fr 1fr; gap: 40px; padding: 32px; background: var(--sf); border: 1px solid var(--bd); border-radius: 20px; }
  blockquote { display: flex; align-items: start; gap: 12px; margin: 0; padding: 20px; border-radius: 14px; background: var(--priSoft); color: var(--tx); font-size: 19px; font-weight: 600; }
  blockquote svg { width: 22px; height: 24px; flex: none; color: var(--pri); }
  .example-note { color: var(--mut); font-size: 13px; margin-top: 16px; }
  dl { margin: 0; align-self: center; }
  dl div { padding: 14px 0; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 18px; border-bottom: 1px solid var(--bd); }
  dt { color: var(--mut); } dd { margin: 0; font-weight: 650; }
  .guide-section { padding: 64px 0; border-bottom: 1px solid var(--bd); scroll-margin-top: 90px; }
  .setup-steps { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .setup-steps li { display: flex; align-items: start; gap: 16px; padding: 24px; background: var(--sf); border: 1px solid var(--bd); border-radius: 16px; }
  .step-number { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; flex: none; background: var(--pri); color: var(--priText); font-weight: 700; }
  .setup-steps p, .text-section p, .guide-plans p { color: var(--mut); }
  .text-section p { max-width: 900px; font-size: 17px; margin-top: 16px; }
  .condition-example { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 24px; font: 600 14px/1.5 var(--mono); }
  .condition-example span { padding: 14px 18px; border-radius: 12px; background: var(--sf); border: 1px solid var(--bd); }
  .condition-example b { color: var(--cat3); }
  .guide-plans { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; }
  .guide-plans article { border: 1px solid var(--bd); border-radius: 16px; padding: 24px; background: var(--sf); }
  .text-link { display: inline-block; color: var(--cat3); font-weight: 600; margin-top: 22px; }
  .guide-cta { padding: 64px 0; text-align: center; }
  .guide-cta p { color: var(--mut); margin-bottom: 24px; }
  @media(max-width: 860px) {
    .guide-hero { grid-template-columns: 1fr; gap: 32px; padding: 32px 0 40px; }
    h1 { font-size: 34px; } .guide-intro { font-size: 17px; }
    .guide-phone { --pw: 210px; }
    .voice-example { grid-template-columns: 1fr; gap: 20px; padding: 20px; }
    blockquote { padding: 16px; font-size: 17px; }
    .guide-section { padding: 42px 0; }
    .setup-steps, .guide-plans { grid-template-columns: 1fr; gap: 16px; }
    .setup-steps li { padding: 20px; }
    dd { overflow-wrap: anywhere; }
  }
</style>
