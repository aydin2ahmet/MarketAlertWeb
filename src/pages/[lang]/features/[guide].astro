---
import Base from '../../../layouts/Base.astro';
import ProgressiveShot from '../../../components/ProgressiveShot.astro';
import content from '../../../i18n/content.json';
import guides from '../../../i18n/alert-guides.json';
import rsiGuides from '../../../i18n/rsi-alerts.json';
import screenSizes from '../../../i18n/rsi-screens.json';
import { GA_ID, LOCALES, SITE, legalUrl } from '../../../config';

export function getStaticPaths() {
  return LOCALES.flatMap(locale => Object.keys(guides.en).map(guide => ({ params: { lang: locale.code, guide }, props: { locale, guide } })));
}
const { locale, guide } = Astro.props;
const code = locale.code;
const t = (content as any)[code];
const g = (guides as any)[code][guide];
const r = (rsiGuides as any)[code];
const volume = guide === 'volume-spike-alerts';
const resultKind = volume ? 'volume-result' : 'desktop-voice-result';
const resultVersion = volume ? 'volume1' : '3x-conditions2';
const setupTitle = ({ tr: 'Adım adım kurulum', en: 'Step-by-step setup', de: 'Schrittweise Einrichtung', fr: 'Configuration pas à pas', es: 'Configuración paso a paso', 'pt-br': 'Configuração passo a passo', ru: 'Пошаговая настройка', ja: '設定の手順', zh: '分步设置', hi: 'चरण-दर-चरण सेटअप', ar: 'الإعداد خطوة بخطوة' } as Record<string, string>)[code];
const path = `/${code}/features/${guide}/`;
const alternates = LOCALES.map(l => ({ hreflang: l.hreflang, href: `/${l.code}/features/${guide}/` }));
const related = [{ slug: 'rsi-alerts', link: r.link }, ...Object.entries((guides as any)[code]).filter(([slug]) => slug !== guide).map(([slug, page]: [string, any]) => ({ slug, link: page.link }))];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: g.title, description: g.description, url: SITE + path, inLanguage: locale.hreflang },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'MarketAlert', item: `${SITE}/${code}/` },
    { '@type': 'ListItem', position: 2, name: g.link, item: SITE + path },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: locale.hreflang, mainEntity: g.faq.map((q: string[]) => ({ '@type': 'Question', name: q[0], acceptedAnswer: { '@type': 'Answer', text: q[1] } })) },
];
---
<Base lang={code === 'pt-br' ? 'pt-BR' : code} dir={locale.dir} title={g.title} description={g.description} path={path} ogImage={`/og/${code}.png`} jsonLd={jsonLd} alternates={alternates}>
  <a class="skip" href="#setup">{setupTitle}</a>
  <header class="hd">
    <a class="logo" href={`/${code}/`}><img src="/icons/logo-96.png" alt="" width="32" height="32" /><b>MarketAlert</b></a>
    <nav aria-label="MarketAlert"><a href={`/${code}/#features`}>{t.nav[0]}</a><a href="#plans">{t.nav[2]}</a><a href="#faq">{t.nav[3]}</a></nav>
    <div class="hx">
      <label class="lsel"><span class="skip">{t.ui.lang}</span><select id="lang" aria-label={t.ui.lang}>{LOCALES.map(l => <option value={l.code} selected={l.code === code} lang={l.hreflang}>{l.name}</option>)}</select></label>
      <button class="thm" id="theme" type="button" aria-label={t.ui.theme} title={t.ui.theme}>
        <svg class="ic i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 14.5A8 8 0 019.5 4 8 8 0 1020 14.5z" /></svg>
        <svg class="ic i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
      <a class="btn" href={`/${code}/#download`} data-ev="cta_click">{t.download}</a>
    </div>
  </header>
  <main class="alert-guide">
    <nav class="breadcrumbs" aria-label="MarketAlert"><a href={`/${code}/`}>MarketAlert</a><span aria-hidden="true"> / </span><span>{g.link}</span></nav>
    <section class="guide-hero">
      <p class="kicker">BINANCE · {volume ? 'VOLUME / SMA' : 'RSI + EMA'} · TELEGRAM</p>
      <h1>{g.h1}</h1><p class="intro">{g.intro}</p>
      <a class="btn" href="#setup">{setupTitle} <span aria-hidden="true">↓</span></a>
    </section>
    <section class="example" aria-labelledby="example-title">
      <div class="example-copy"><p class="kicker">{volume ? '15m · SMA(20) · 3×' : '1h · RSI(14) · EMA(20)'}</p><h2 id="example-title">{r.exampleTitle}</h2>
        <blockquote><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3" /><path d="M5 10v2a7 7 0 0014 0v-2M12 19v3M8 22h8" /></svg><p>{g.prompt}</p></blockquote>
        <div class="condition" dir="ltr">{volume ? <><span>VOLUME</span><b>&gt;</b><span>3 × SMA(20)</span></> : <><span>RSI(14) &lt; 30</span><b>AND</b><span>PRICE &gt; EMA(20)</span></>}</div>
        <p class="example-foot" dir="ltr">BINANCE SPOT · USDT · TOP 100 → TELEGRAM</p>
      </div>
      <figure>
        <div class="result-screen">
          <ProgressiveShot class="sh-l" src={`/shots/${code}/light/rsi/${resultKind}.webp?v=${resultVersion}`} alt={g.caption} width="390" height={(screenSizes as any)[code].light[resultKind]} loading="lazy" decoding="async" />
          <ProgressiveShot class="sh-d" src={`/shots/${code}/dark/rsi/${resultKind}.webp?v=${resultVersion}`} alt="" width="390" height={(screenSizes as any)[code].dark[resultKind]} loading="lazy" decoding="async" />
        </div>
        <figcaption>{g.caption}</figcaption>
      </figure>
    </section>
    <section id="setup" class="guide-section"><p class="kicker">01 → 04</p><h2>{setupTitle}</h2><ol class="steps">{g.steps.map((step: string[], i: number) => <li><span class="step-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><div><h3>{step[0]}</h3><p>{step[1]}</p></div></li>)}</ol></section>
    <section class="guide-section explain">{g.details.map((section: string[]) => <article><h2>{section[0]}</h2><p>{section[1]}</p></article>)}</section>
    {!volume && <div class="logic-example" aria-label={g.details[0][0]} dir="ltr"><code>RSI = 28 · PRICE &lt; EMA20</code><strong>AND → ✕</strong><code>RSI = 28 · PRICE &gt; EMA20</code><strong>AND → ✓</strong></div>}
    <section id="plans" class="guide-section"><h2>{r.plansTitle}</h2><div class="guide-plans">{r.plans.map((p: string[]) => <article><h3>{p[0]}</h3><p>{p[1]}</p></article>)}</div><a class="text-link" href={`/${code}/#plans`}>{r.plansLink} ↗</a></section>
    <section id="faq" class="guide-section"><h2>{t.faqTitle}</h2><div class="faq">{g.faq.map((q: string[], i: number) => <details open={i === 0}><summary>{q[0]}</summary><p>{q[1]}</p></details>)}</div></section>
    <nav class="related" aria-label={t.nav[0]}>{related.map(page => <a href={`/${code}/features/${page.slug}/`}>{page.link}<span aria-hidden="true">↗</span></a>)}</nav>
    <section class="guide-cta"><h2>{r.ctaTitle}</h2><p>{r.cta}</p><a class="btn" href={`/${code}/#download`} data-ev="cta_click">{r.home} ↗</a></section>
  </main>
  <footer class="ft"><div class="ftop"><a class="logo" href={`/${code}/`}><img src="/icons/logo-96.png" alt="" width="32" height="32" /><b>MarketAlert</b></a><nav class="legal"><a href={legalUrl('privacy', code)}>{t.legal[0]}</a><a href={legalUrl('terms', code)}>{t.legal[1]}</a>{GA_ID && <button type="button" class="lnk" data-consent-open>{t.consent.prefs}</button>}</nav></div><nav class="langs" aria-label={t.ui.lang}>{LOCALES.map(l => <a href={`/${l.code}/features/${guide}/`} hreflang={l.hreflang} lang={l.hreflang} aria-current={l.code === code ? 'page' : undefined} data-ev="language_switch" data-to={l.code}>{l.name}</a>)}</nav><p class="disc">{t.disclaimer}</p><p class="copy">© 2026 MarketAlert · marketalertapp.com</p></footer>
  <script>
    const root = document.documentElement;
    document.getElementById('theme')?.addEventListener('click', () => {
      const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      root.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('theme', root.dataset.theme); } catch (e) { /* depolama kapalı olabilir */ }
      (window as any).maTrack?.('theme_toggle', { theme: root.dataset.theme });
    });
    document.getElementById('lang')?.addEventListener('change', e => {
      const code = (e.target as HTMLSelectElement).value;
      const slug = location.pathname.split('/')[3];
      (window as any).maTrack?.('language_switch', { to_lang: code });
      location.href = `/${code}/features/${slug}/` + location.hash;
    });
  </script>
</Base>

<style>
  .alert-guide { max-width: 1200px; padding: 28px 20px 0; margin-inline: auto; }
  .skip:not(:focus) { position: fixed; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); }
  .breadcrumbs { display: flex; flex-wrap: wrap; gap: 8px; color: var(--mut); font-size: 13px; }
  .guide-hero { padding: 56px 0 48px; max-width: 940px; }
  .kicker { font: 600 12px/1.6 var(--mono); color: var(--cat3); margin-bottom: 16px; }
  h1 { font-size: clamp(34px, 4.2vw, 56px); text-wrap: balance; }
  .intro { color: var(--mut); font-size: 19px; max-width: 850px; margin: 24px 0; }
  h2 { font-size: clamp(24px, 3vw, 32px); margin-bottom: 18px; text-wrap: balance; }
  h3 { font-size: 18px; margin-bottom: 8px; }
  .example { display: grid; grid-template-columns: 1.3fr 1fr; align-items: center; gap: 40px; padding: 36px; border: 1px solid var(--bd); border-radius: 24px; background: radial-gradient(ellipse at top right, var(--priSoft), transparent 70%), var(--sf); }
  blockquote { display: flex; gap: 12px; padding: 20px; margin: 0; background: var(--priSoft); border-radius: 14px; font-size: 20px; font-weight: 600; }
  blockquote svg { width: 24px; height: 24px; flex: none; color: var(--pri); }
  .condition { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 24px; font: 600 13px/1.5 var(--mono); }
  .condition span { border: 1px solid var(--bd); border-radius: 10px; padding: 10px; background: var(--bg); }
  .condition b { color: var(--cat3); }
  .example-foot { font: 500 11px/1.8 var(--mono); color: var(--mut); margin-top: 18px; }
  figure { margin: 0; min-width: 0; }
  figcaption { color: var(--mut); font-size: 12px; margin-top: 16px; text-align: center; }
  .result-screen { width: min(100%, 320px); margin-inline: auto; border: 1px solid var(--bd); border-radius: 22px; overflow: hidden; box-shadow: 0 16px 50px #0002; }
  .result-screen img { width: 100%; height: auto; }
  .guide-section { padding: 56px 0; border-bottom: 1px solid var(--bd); scroll-margin-top: 90px; }
  .steps { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .steps li { display: flex; align-items: start; gap: 16px; padding: 24px; border: 1px solid var(--bd); border-radius: 16px; background: var(--sf); }
  .step-number { color: var(--pri); font: 600 24px/1.3 var(--mono); }
  .steps p, .guide-plans p, .explain p, .guide-cta p { color: var(--mut); }
  .explain { display: grid; gap: 36px; }
  .explain p { max-width: 900px; font-size: 17px; }
  .logic-example { display: grid; grid-template-columns: 1fr auto; gap: 18px; padding: 24px; background: var(--sf); border-radius: 16px; margin-top: 24px; font-size: 14px; }
  .logic-example code { overflow-wrap: anywhere; }
  .guide-plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .guide-plans article { padding: 24px; border: 1px solid var(--bd); border-radius: 16px; background: var(--sf); }
  .text-link { display: inline-block; color: var(--cat3); margin-top: 24px; font-weight: 600; }
  .related { display: flex; flex-wrap: wrap; gap: 16px; padding-top: 32px; }
  .related a { flex: 1; min-width: min(100%, 260px); display: flex; align-items: center; justify-content: space-between; gap: 16px; border: 1px solid var(--bd); padding: 20px; border-radius: 14px; }
  .related a:hover, .breadcrumbs a:hover { color: var(--cat3); }
  .guide-cta { padding: 64px 0; text-align: center; }
  .guide-cta p { margin-bottom: 24px; }
  @media(max-width: 760px) {
    .guide-hero { padding: 32px 0; } .intro { font-size: 17px; }
    .example { grid-template-columns: 1fr; gap: 28px; padding: 20px; }
    blockquote { font-size: 17px; padding: 16px; } .result-screen { max-width: 300px; }
    .steps, .guide-plans { grid-template-columns: 1fr; } .steps li { padding: 20px; }
    .guide-section { padding: 40px 0; } .logic-example { font-size: 11px; gap: 16px 8px; padding: 16px; }
  }
</style>
