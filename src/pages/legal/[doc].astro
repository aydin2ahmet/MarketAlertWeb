---
// Dil kodu olmayan belge bağlantıları, /legal/ ile aynı dil seçimini kullanır.
export const getStaticPaths = () => ['privacy', 'terms', 'delete-account'].map(doc => ({ params: { doc } }));
const doc = Astro.params.doc!;
const fallback = `/en/legal/${doc}/`;
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Legal · MarketAlert</title><meta name="robots" content="noindex" />
<link rel="canonical" href={`https://www.marketalertapp.com${fallback}`} />
<script is:inline define:vars={{ DOC: `${doc}/` }}>
(function () {
  var codes = ['tr','en','zh','es','hi','ar','pt-br','fr','ru','de','ja'];
  var norm = function (v) { v = String(v || '').toLowerCase(); var b = v.split('-')[0]; return b === 'pt' ? 'pt-br' : b; };
  var pick = norm(new URLSearchParams(location.search).get('lang'));
  if (codes.indexOf(pick) < 0) { try { pick = localStorage.getItem('lang'); } catch (e) { pick = null; } }
  if (codes.indexOf(pick) < 0) {
    pick = null;
    var list = navigator.languages || [navigator.language];
    for (var i = 0; i < list.length && !pick; i++) if (codes.indexOf(norm(list[i])) >= 0) pick = norm(list[i]);
  }
  location.replace('/' + (pick || 'en') + '/legal/' + DOC + location.hash);
})();</script></head>
<body style="font-family:system-ui,sans-serif;padding:24px"><a href={fallback}>Continue to document</a></body></html>
