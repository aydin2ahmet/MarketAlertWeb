---
// Kök adreste İngilizce içerik hazırdır; diğer diller head içinde erken seçilir.
import Base from '../layouts/Base.astro';
import Landing from '../components/Landing.astro';
import content from '../i18n/content.json';
import { LOCALES, SITE } from '../config';
const t = content.en;
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'MarketAlert', url: SITE + '/', inLanguage: LOCALES.map(l => l.hreflang) }];
---
<Base lang="en" dir="ltr" title={t.meta.title} description={t.meta.desc} path="/" canonicalPath="/en/" ogImage="/og/en.png" jsonLd={jsonLd} autoLocale>
  <Landing t={t} code="en" appLocale="en" />
</Base>
