---
/**
 * İlk ekran, tasarım K3-1 (2026-11-10, Ahmet): solda başlık, sağda gerçek "Telegram bağlı" ekranı ve
 * önüne düşmüş Telegram mesajı. Başka yöntemlerin istediği üç şey (sohbet kimliği, bot jetonu,
 * Binance API anahtarı) görselin kenarlarına eğik dağıtılmış, üstleri çizili: hiçbiri gerekmez.
 * Telefonda: başlık → görsel → giriş metni.
 */
import TgShot from './TgShot.astro';
import TgChat from './TgChat.astro';
import { msgHtml, tgData } from '../../lib/telegram';

interface Props { code: string; kicker: string; h1: string; introHtml: string; setupTitle: string; chips: string[]; no: string; alt: string; chat: string }
const { code, kicker, h1, introHtml, setupTitle, chips, no, alt, chat } = Astro.props;
const m = tgData(code).msgs['01'];
// Etiketlerin yeri (görsel kutusuna göre yüzde) ve eğimi.
const POS = [[0, 0, -4], [58, 4, 5], [2, 94, 3]];
---
<section class="tgh">
  <div class="tgh-head"><p class="kicker">{kicker}</p><h1>{h1}</h1></div>
  <div class="tgh-vis">
    <div class="tgh-ph"><TgShot code={code} k="on" alt={alt} loading="eager" sizes="(max-width:760px) 52vw, 220px" /></div>
    <TgChat code={code} label={chat} class="tgh-tg"><div class="tgm" set:html={msgHtml(m, '14:32')} /></TgChat>
    {chips.map((c, i) => <span class="nx" style={`inset-inline-start:${POS[i][0]}%;top:${POS[i][1]}%;--r:${POS[i][2]}deg`}><s>{c}</s><b aria-hidden="true">✕</b><span class="skip-t">{no}</span></span>)}
  </div>
  <div class="tgh-body"><p class="intro" set:html={introHtml} />
    <a class="btn" href="#setup">{setupTitle} <span aria-hidden="true">↓</span></a></div>
</section>

<style>
  .tgh { display: grid; grid-template-columns: minmax(0, 1fr) 600px; grid-template-areas: 'head vis' 'body vis'; column-gap: 40px; align-items: start; padding: 48px 0 40px; }
  .tgh-head { grid-area: head; align-self: end; padding-top: 40px; }
  .tgh-body { grid-area: body; }
  .tgh-vis { grid-area: vis; position: relative; width: 600px; height: 620px; }
  .kicker { font: 600 12px/1.6 var(--mono); color: var(--cat3); margin-bottom: 16px; }
  h1 { font-size: clamp(34px, 4.2vw, 52px); text-wrap: balance; }
  .intro { color: var(--mut); font-size: 18px; margin: 22px 0 24px; }
  .tgh-ph { position: absolute; inset-inline-start: 150px; top: 62px; width: 220px; padding: 6px; border-radius: 32px; background: var(--frame); box-shadow: var(--shadow), inset 0 0 0 1px rgba(255, 255, 255, .08); z-index: 2; }
  .tgh-ph :global(img) { display: block; width: 100%; height: auto; border-radius: 26px; }
  .tgh-vis :global(.tgh-tg) { position: absolute; inset-inline-end: 0; bottom: 84px; width: 300px; transform: rotate(-2deg); z-index: 3; font-size: 14px; }
  .nx { position: absolute; z-index: 4; white-space: nowrap; transform: rotate(var(--r)); font-weight: 650; font-size: 14px; background: var(--sf); border: 1px solid var(--bd); border-radius: 999px; padding: 8px 14px; color: var(--mut); box-shadow: 0 8px 18px -10px rgba(0, 0, 0, .35); }
  .nx s { text-decoration-color: #C2410C; text-decoration-thickness: 2px; }
  .nx b { display: inline-grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: color-mix(in srgb, #C2410C 14%, transparent); color: #C2410C; font-size: 11px; margin-inline-start: 8px; }
  .skip-t { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  @media (max-width: 1080px) {
    .tgh { grid-template-columns: minmax(0, 1fr) 480px; }
    .tgh-vis { width: 480px; height: 540px; }
    .tgh-ph { inset-inline-start: 80px; width: 200px; }
    .tgh-vis :global(.tgh-tg) { width: 270px; font-size: 13px; }
  }
  @media (max-width: 860px) {
    .tgh { grid-template-columns: 1fr; grid-template-areas: 'head' 'vis' 'body'; padding: 28px 0 32px; }
    .tgh-head { padding-top: 0; }
    .tgh-vis { width: 100%; max-width: 460px; height: auto; aspect-ratio: 460 / 520; margin: 26px auto 0; }
    .tgh-ph { inset-inline-start: 4%; top: 9%; width: 50%; padding: 4px; border-radius: 22px; }
    .tgh-ph :global(img) { border-radius: 18px; }
    .tgh-vis :global(.tgh-tg) { width: 64%; bottom: 8%; font-size: 11.5px; }
    .tgh-vis :global(.tgh-tg .tgc-hd) { padding: 6px 10px; }
    .tgh-vis :global(.tgh-tg .tgc-hd img) { width: 26px; height: 26px; }
    .tgh-vis :global(.tgh-tg .tgc-hd b) { font-size: 12px; }
    .nx { font-size: 12px; padding: 6px 10px; }
    .intro { font-size: 17px; }
  }
</style>
