---
/** Bir uygulama ekranının açık ve koyu hâli (temaya göre biri görünür). */
import ProgressiveShot from '../ProgressiveShot.astro';
import { gcSize, gcSrc } from '../../lib/gc';
interface Props { code: string; k: string; alt: string; sizes: string }
const { code, k, alt, sizes } = Astro.props;
const l = gcSize(code, 'light', k), d = gcSize(code, 'dark', k);
---
<ProgressiveShot class="sh-l" src={gcSrc(code, 'light', k)} alt={alt} width={String(l[0])} height={String(l[1])} loading="lazy" decoding="async" sizes={sizes} />
<ProgressiveShot class="sh-d" src={gcSrc(code, 'dark', k)} alt="" width={String(d[0])} height={String(d[1])} loading="lazy" decoding="async" sizes={sizes} />
