---
/**
 * Koşul örneği: her coin/durum kendi kartında. Her koşul gri bir kutucukta "değer / hedef",
 * sağında ince çerçeveli ✓ ya da ✕; altta sonuç (zil ya da kapalı zil). Tasarım I3 (2026-11-08).
 * Metinler src/i18n/logic-cards.json içinde, dile göre biçimlenmiş sayılarla.
 */
interface Card { coin: string; tag: string; tiles: [string, string, string | null, boolean | null][]; res: [string, boolean] }
interface Props { data: { kicker: string; cond: string[]; cards: Card[] }; and: string; condLabel: string }
const { data, and, condLabel } = Astro.props;
const tone = (c: string) => [...c].reduce((a, ch) => a + ch.charCodeAt(0), 0) % 4;
const CHECK = '<path d="M5 12.5l4.5 4.5L19 7.5"/>';
const X = '<path d="M7 7l10 10M17 7L7 17"/>';
const BELL = '<path d="M6 9a6 6 0 0 1 12 0c0 6 2.5 7.5 2.5 7.5h-17S6 15 6 9"/><path d="M10.3 20a1.9 1.9 0 0 0 3.4 0"/>';
const BELLOFF = '<path d="M8.7 4A6 6 0 0 1 18 9c0 2.4.4 4 .9 5.2M6.2 6.6A6 6 0 0 0 6 9c0 6-2.5 7.5-2.5 7.5h13"/><path d="M10.3 20a1.9 1.9 0 0 0 3.4 0"/><path d="M3 3l18 18"/>';
const icon = (d: string, s: number, w: number) => `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${w}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
---
<div class="lc">
  <p class="lc-hd"><span class="lc-k">{data.kicker}</span>{condLabel} {data.cond.map((c, i) => <>{i > 0 && <span class="lc-and">{and}</span>}<b>{c}</b></>)}</p>
  <div class={`lc-grid lc-n${data.cards.length}`}>
    {data.cards.map(card => <div class="lc-card">
      <div class="lc-top"><span class="lc-coin"><span class={`lc-av lc-t${tone(card.coin)}`} aria-hidden="true">{card.coin[0]}</span>{card.coin}</span><span class="lc-tag">{card.tag}</span></div>
      {card.tiles.map(([label, value, target, ok]) => <div class="lc-tile">
        <span class="lc-l">{label}</span>
        <span class={`lc-v ${ok === null ? '' : ok ? 'y' : 'n'}`}><bdi>{value}</bdi>{target && <span> <bdi>{target}</bdi></span>}</span>
        {ok !== null && <span class={`lc-ring ${ok ? 'y' : 'n'}`} set:html={icon(ok ? CHECK : X, 12, 2.6)} />}
      </div>)}
      <div class={`lc-res ${card.res[1] ? 'y' : 'n'}`}><span class="lc-ring" set:html={icon(card.res[1] ? BELL : BELLOFF, 11, 2.4)} />{card.res[0]}</div>
    </div>)}
  </div>
</div>

<style>
  .lc { --ok: #15936a; --no: #d9622b; margin-top: 28px; max-width: 760px; }
  :global(:root[data-theme=dark]) .lc { --ok: #43d19e; --no: #ff8f5e; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme=light])) .lc { --ok: #43d19e; --no: #ff8f5e; } }
  .lc-hd { margin: 0 0 12px; font-size: 14px; color: var(--mut); line-height: 1.6; }
  .lc-hd b { color: var(--tx); font-weight: 600; }
  .lc-k { display: block; font: 600 11px/1 var(--mono, ui-monospace, monospace); letter-spacing: .06em; color: var(--mut); opacity: .8; margin-bottom: 8px; }
  .lc-and { font: 700 11px/1 var(--mono, ui-monospace, monospace); color: var(--pri, #f5a524); margin: 0 6px; }
  .lc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .lc-grid.lc-n2 { grid-template-columns: repeat(2, 1fr); max-width: 520px; }
  .lc-card { background: var(--sf); border: 1px solid var(--bd); border-radius: 16px; padding: 14px; display: grid; gap: 10px; align-content: start; }
  .lc-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .lc-coin { display: flex; align-items: center; gap: 9px; font-weight: 700; font-size: 14.5px; }
  .lc-av { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; font-weight: 800; font-size: 12px; }
  .lc-t0 { background: #fde8e8; color: #b42318; } .lc-t1 { background: #fbe7f3; color: #a3145f; } .lc-t2 { background: #e6edfd; color: #2346a8; } .lc-t3 { background: #e5f4ee; color: #12704f; }
  :global(:root[data-theme=dark]) .lc-t0 { background: #3a1a1a; color: #ff9a8f; } :global(:root[data-theme=dark]) .lc-t1 { background: #3a1830; color: #ff8fcf; } :global(:root[data-theme=dark]) .lc-t2 { background: #1a2440; color: #9db7ff; } :global(:root[data-theme=dark]) .lc-t3 { background: #12301f; color: #6fe0b3; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme=light])) .lc-t0 { background: #3a1a1a; color: #ff9a8f; } :global(:root:not([data-theme=light])) .lc-t1 { background: #3a1830; color: #ff8fcf; }
    :global(:root:not([data-theme=light])) .lc-t2 { background: #1a2440; color: #9db7ff; } :global(:root:not([data-theme=light])) .lc-t3 { background: #12301f; color: #6fe0b3; }
  }
  .lc-tag { font-size: 11.5px; color: var(--mut); }
  .lc-tile { background: color-mix(in srgb, var(--bd) 45%, transparent); border-radius: 10px; padding: 8px 10px; display: grid; grid-template-columns: 1fr auto; gap: 2px 10px; align-items: center; }
  .lc-l { font-size: 11px; color: var(--mut); grid-column: 1; }
  .lc-v { font-size: 13px; font-weight: 600; grid-column: 1; }
  .lc-v span { color: var(--mut); font-weight: 500; }
  .lc-tile .lc-ring { grid-column: 2; grid-row: 1 / 3; }
  .y { color: var(--ok); } .n { color: var(--no); }
  .lc-ring { width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; border: 1.5px solid currentColor; flex: none; }
  .lc-ring :global(svg) { display: block; }
  .lc-res { font-size: 12.5px; font-weight: 650; display: flex; align-items: center; gap: 7px; padding-top: 2px; }
  @media (max-width: 700px) { .lc-grid, .lc-grid.lc-n2 { grid-template-columns: 1fr; max-width: none; } }
</style>
