---
/**
 * "MarketAlert nedir, ne değildir?" bölümü (tasarım N3 · Radar, 2026-11-14): solda tanım, yaptıkları
 * ve "dışarıda kalanlar"; sağda dönen radar coinleri tarar, değdiği coin yanar.
 * Metinler content.json içinde `what` (arama motorları ve yapay zekâ özetleri için düz metin kalır).
 */
interface Props { d: { title: string; def: string; yesT: string; noT: string; yes: string[]; no: string[] } }
const { d } = Astro.props;
// Radar üzerindeki coinler: [ad, x%, y%]; açı tepeden saat yönünde ölçülür, süpürge geçince yanar.
const COINS: [string, number, number][] = [['BTC', 50, 12], ['ETH', 84, 34], ['SOL', 78, 74], ['BNB', 40, 88], ['XRP', 14, 62], ['DOGE', 22, 24], ['ADA', 64, 52], ['AVAX', 34, 46], ['LINK', 58, 26], ['TON', 86, 58], ['PEPE', 50, 72]];
const ang = (x: number, y: number) => ((Math.atan2(x - 50, -(y - 50)) * 180 / Math.PI) + 360) % 360;
const PERIOD = 4;
const check = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
const lock = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></svg>';
---
<section class="wi" aria-labelledby="wi-t">
  <div class="wi-wrap">
    <div>
      <h2 class="st" id="wi-t"><span class="hash">#</span> {d.title}</h2>
      <p class="wi-def">{d.def}</p>
      <h3 class="wi-lab y">{d.yesT}</h3>
      <ul class="wi-yes">{d.yes.map(s => <li><Fragment set:html={check} /><span>{s}</span></li>)}</ul>
      <h3 class="wi-lab n">{d.noT}</h3>
      <ul class="wi-no">{d.no.map(s => <li><Fragment set:html={lock} />{s}</li>)}</ul>
    </div>
    <div class="radar" aria-hidden="true" dir="ltr">
      <div class="sw"></div>
      {COINS.map(([c, x, y]) => <span class="c" style={`left:${x}%;top:${y}%;animation-delay:${(ang(x, y) / 360 * PERIOD - PERIOD).toFixed(2)}s`}>{c}</span>)}
      <img class="mid" src="/icons/logo-96.png" alt="" width="48" height="48" loading="lazy" decoding="async" />
    </div>
  </div>
</section>

<style>
  .wi { --ok: var(--up); --no: #C2410C; padding: 56px var(--gut) 48px; background: radial-gradient(120% 70% at 50% 0%, color-mix(in srgb, var(--pri) 16%, transparent), transparent 60%); overflow: hidden; }
  :global(:root[data-theme=dark]) .wi { --no: #FF9F66; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme=light])) .wi { --no: #FF9F66; } }
  .wi-wrap { display: grid; gap: 30px; align-items: center; max-width: 1080px; }
  .wi-def { font-size: 18px; line-height: 1.55; color: var(--tx); margin-top: 14px; max-width: 620px; }
  .wi-lab { font: 700 12px/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; margin: 24px 0 12px; }
  .wi-lab.y { color: var(--ok); } .wi-lab.n { color: var(--no); }
  :global(:root:is([lang=ar], [lang=hi], [lang=zh], [lang=ja])) .wi-lab { font-family: var(--f); font-size: 13px; letter-spacing: 0; }
  .wi ul { list-style: none; margin: 0; padding: 0; }
  .wi-yes { display: grid; gap: 10px; }
  .wi-yes li { display: flex; gap: 10px; align-items: flex-start; font-size: 16px; color: var(--tx); }
  .wi-yes :global(svg) { width: 20px; height: 20px; flex: none; color: var(--ok); margin-top: 2px; }
  .wi-no { display: flex; flex-wrap: wrap; gap: 8px; }
  .wi-no li { display: inline-flex; gap: 7px; align-items: center; border: 1px solid var(--bd); border-radius: 999px; padding: 7px 13px; font-size: 14px; color: var(--mut); background: var(--sf); }
  .wi-no :global(svg) { width: 15px; height: 15px; flex: none; color: var(--no); }
  .radar { position: relative; width: min(340px, 86vw); aspect-ratio: 1; margin: 0 auto; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--pri) 40%, transparent);
    background: radial-gradient(circle, transparent 0 24%, color-mix(in srgb, var(--pri) 30%, transparent) 24.3% 24.7%, transparent 25% 49%, color-mix(in srgb, var(--pri) 26%, transparent) 49.3% 49.7%, transparent 50% 74%, color-mix(in srgb, var(--pri) 22%, transparent) 74.3% 74.7%, transparent 75%), color-mix(in srgb, var(--sf) 70%, transparent); }
  .sw { position: absolute; inset: 0; border-radius: 50%; background: conic-gradient(from 0deg, transparent 80%, color-mix(in srgb, var(--pri) 55%, transparent)); animation: wi-sw 4s linear infinite; }
  @keyframes wi-sw { to { transform: rotate(360deg); } }
  .c { position: absolute; transform: translate(-50%, -50%); font: 700 11px var(--mono); padding: 4px 7px; border-radius: 999px; background: var(--sf); border: 1px solid var(--bd); color: var(--mut); animation: wi-hit 4s linear infinite; }
  @keyframes wi-hit { 0%, 11% { background: var(--pri); border-color: var(--pri); color: var(--priText); box-shadow: 0 0 0 6px color-mix(in srgb, var(--pri) 25%, transparent); } 16%, 100% { background: var(--sf); border-color: var(--bd); color: var(--mut); box-shadow: none; } }
  .mid { position: absolute; left: 50%; top: 50%; width: 48px; height: 48px; border-radius: 13px; transform: translate(-50%, -50%); box-shadow: 0 0 0 8px color-mix(in srgb, var(--bg) 70%, transparent); }
  @media (min-width: 861px) { .wi { padding: 88px var(--gut) 80px; } .wi-wrap { grid-template-columns: 1.1fr .9fr; gap: 48px; } .radar { width: 380px; } }
  @media (prefers-reduced-motion: reduce) { .sw, .c { animation: none; } }
</style>
