---
/**
 * Kur ve sonucunu gör, tasarım S5 (2026-11-11, Ahmet): yön ve zaman dilimi seçilince uygulamanın gerçek
 * "Alarm oluştur" ekranı (MACD koşulu, 11 dil × açık/koyu × 2 yön × 6 zaman dilimi), push ve Telegram mesajı birlikte değişir.
 * Telefonda S5-B: seçimler alt alta, sonuç üç sekmede. Masaüstünde S5-A: solda yön düğmeleri alt alta, sağda
 * zaman dilimleri 3×2, iki başlık aynı satırda; altta ekran, yanında push ve Telegram.
 */
import TgChat from '../telegram/TgChat.astro';
import { msgHtml } from '../../lib/telegram';
import { TFS, condText, example, fill, mcLang, notifyTime, pushHtml, sheetSrc, tgMsg } from '../../lib/macd';
import '../../styles/macd.css';

interface Props { code: string; mc: any }
const { code, mc } = Astro.props;
const L = mcLang(code);
const dir = 'd', tf = '1d', ex = example(dir), time = notifyTime(L, tf);
const cond = condText(L, dir, tf);
const UP = '<svg class="mc-ico u" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 15 7-7 7 7M12 8v12"/></svg>';
const DN = '<svg class="mc-ico d" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 9 7 7 7-7M12 16V4"/></svg>';
const data = { code, shotAlt: mc.shotAlt };
---
<div class="mcs" data-mc={JSON.stringify(data)}>
  <p class="mcs-lead">{mc.s5Lead}</p>
  <div class="mcs-a">
    <div class="mcs-ctl">
      <div><div class="mc-lab">{mc.when}</div><div class="mc-seg d2" role="group" aria-label={mc.when}><button type="button" data-d="u" aria-pressed="false"><Fragment set:html={UP} />{mc.upLong}</button><button type="button" data-d="d" aria-pressed="true"><Fragment set:html={DN} />{mc.downLong}</button></div></div>
      <div><div class="mc-lab">{mc.tfLabel}</div><div class="mc-seg t6" role="group" aria-label={mc.tfLabel} dir="ltr">{TFS.map(t => <button type="button" data-tf={t} aria-pressed={String(t === tf)}>{t}</button>)}</div></div>
    </div>
    <div class="mc-sent" dir="auto">{cond}</div>
    <div class="mcs-three">
      <div class="mcs-shot"><div class="mc-chn">{mc.chnApp}</div><img class="mc-shot sh-l" src={sheetSrc(code, 'light', dir, tf)} alt={fill(mc.shotAlt, { cond })} width="540" height="1132" loading="lazy" decoding="async" /><img class="mc-shot sh-d" src={sheetSrc(code, 'dark', dir, tf)} alt="" width="540" height="1132" loading="lazy" decoding="async" /></div>
      <div class="mcs-side">
        <div><div class="mc-chn">{mc.chnPush}</div><div class="mcp" set:html={pushHtml(L, dir, tf, ex.m, ex.s, time)} /></div>
        <div><div class="mc-chn">{mc.chnTg}</div><TgChat code={code} label={`Telegram: ${fill(L.tg.d, { 0: 'BNB' })}`}><div class="tgm" set:html={msgHtml(tgMsg(L, dir, tf, ex.m, ex.s, ex.p), time)} /></TgChat></div>
      </div>
    </div>
  </div>
  <div class="mcs-b">
    <div class="mc-lab">{mc.when}</div><div class="mc-seg d2" role="group" aria-label={mc.when}><button type="button" data-d="u" aria-pressed="false"><Fragment set:html={UP} />{mc.upShort}</button><button type="button" data-d="d" aria-pressed="true"><Fragment set:html={DN} />{mc.downShort}</button></div>
    <div class="mc-lab">{mc.tfLabel}</div><div class="mc-seg t6" role="group" aria-label={mc.tfLabel} dir="ltr">{TFS.map(t => <button type="button" data-tf={t} aria-pressed={String(t === tf)}>{t}</button>)}</div>
    <div class="mc-sent" dir="auto">{cond}</div>
    <div class="mc-tabs" role="tablist">{mc.tabs.map((t: string, i: number) => <button type="button" role="tab" aria-selected={String(i === 0)} data-v={['app', 'push', 'tg'][i]}>{t}</button>)}</div>
    <div class="mcs-pv">
      <div data-v="app"><img class="mc-shot sh-l" src={sheetSrc(code, 'light', dir, tf)} alt={fill(mc.shotAlt, { cond })} width="540" height="1132" loading="lazy" decoding="async" /><img class="mc-shot sh-d" src={sheetSrc(code, 'dark', dir, tf)} alt="" width="540" height="1132" loading="lazy" decoding="async" /></div>
      <div data-v="push" hidden><div class="mcp" set:html={pushHtml(L, dir, tf, ex.m, ex.s, time)} /><p class="mcs-note">{mc.pushNote}</p></div>
      <div data-v="tg" hidden><TgChat code={code} label={`Telegram: ${fill(L.tg.d, { 0: 'BNB' })}`}><div class="tgm" set:html={msgHtml(tgMsg(L, dir, tf, ex.m, ex.s, ex.p), time)} /></TgChat></div>
    </div>
  </div>
</div>

<script>
  import { condText, example, fill, mcLang, notifyTime, pushHtml, sheetSrc, tgMsg, type Dir } from '../../lib/macd';
  import { msgHtml } from '../../lib/telegram';
  for (const root of document.querySelectorAll<HTMLElement>('.mcs')) {
    const D = JSON.parse(root.dataset.mc!), L = mcLang(D.code);
    for (const w of root.querySelectorAll<HTMLElement>('.mcs-a, .mcs-b')) {
      let dir: Dir = 'd', tf = '1d', view = 'app';
      const upd = () => {
        w.querySelectorAll<HTMLButtonElement>('[data-d]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.d === dir)));
        w.querySelectorAll<HTMLButtonElement>('[data-tf]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.tf === tf)));
        const cond = condText(L, dir, tf), ex = example(dir), time = notifyTime(L, tf);
        w.querySelectorAll('.mc-sent').forEach(e => { e.textContent = cond; });
        w.querySelectorAll<HTMLImageElement>('img.mc-shot').forEach(img => {
          img.src = sheetSrc(D.code, img.classList.contains('sh-d') ? 'dark' : 'light', dir, tf);
          if (img.classList.contains('sh-l')) img.alt = fill(D.shotAlt, { cond });
        });
        w.querySelectorAll('.mcp').forEach(e => { e.innerHTML = pushHtml(L, dir, tf, ex.m, ex.s, time); });
        w.querySelectorAll('.tgm').forEach(e => { e.innerHTML = msgHtml(tgMsg(L, dir, tf, ex.m, ex.s, ex.p), time); });
        w.querySelectorAll<HTMLButtonElement>('[role=tab]').forEach(b => b.setAttribute('aria-selected', String(b.dataset.v === view)));
        w.querySelectorAll<HTMLElement>('.mcs-pv > [data-v]').forEach(x => { x.hidden = x.dataset.v !== view; });
      };
      w.querySelectorAll<HTMLButtonElement>('[data-d]').forEach(b => b.addEventListener('click', () => { dir = b.dataset.d as Dir; upd(); }));
      w.querySelectorAll<HTMLButtonElement>('[data-tf]').forEach(b => b.addEventListener('click', () => { tf = b.dataset.tf!; upd(); }));
      w.querySelectorAll<HTMLButtonElement>('[role=tab]').forEach(b => b.addEventListener('click', () => { view = b.dataset.v!; upd(); }));
    }
  }
</script>

<style>
  .mcs { margin-top: 40px; padding: 24px; border: 1px solid var(--bd); border-radius: 24px; background: radial-gradient(ellipse at top right, var(--priSoft), transparent 70%), var(--sf); }
  .mcs-lead { margin: 0 0 6px; color: var(--mut); font-size: 16px; max-width: 760px; }
  .mcs-ctl { display: grid; grid-template-columns: 300px 1fr; gap: 28px; align-items: start; }
  .mcs-ctl .mc-seg.d2 { grid-template-columns: 1fr; }
  .mcs-ctl .mc-seg.t6 { grid-template-columns: repeat(3, 1fr); }
  .mcs-three { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 32px; margin-top: 18px; align-items: start; }
  .mcs-side { display: grid; gap: 18px; align-content: start; max-width: 420px; }
  .mcs-b { display: none; }
  .mcs-b .mc-lab:first-child { margin-top: 0; }
  .mcs-b .mc-tabs { margin-top: 16px; }
  .mcs-pv { margin-top: 12px; display: grid; justify-items: center; }
  .mcs-pv > div { width: 100%; max-width: 330px; }
  .mcs-pv > div[hidden] { display: none; }
  .mcs-note { font-size: 13px; color: var(--mut); text-align: center; margin: 8px 0 0; }
  @media (max-width: 860px) {
    .mcs { padding: 16px; margin-top: 32px; }
    .mcs-a { display: none; }
    .mcs-b { display: block; }
  }
</style>
