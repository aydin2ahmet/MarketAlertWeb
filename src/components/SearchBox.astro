---
/**
 * Üst çubuktaki site içi arama. Dizin /{dil}/search.json (src/lib/searchIndex.ts) ilk açılışta bir kez indirilir.
 * Kısayol: "/" tuşu açar, Esc kapatır, ↑/↓ ile sonuçlar arasında gezilir.
 */
import content from '../i18n/content.json';

interface Props { code: string }
const { code } = Astro.props;
const ui = (content as any)[code].ui;
---
<div class="srch" data-search data-code={code} data-none={ui.searchNone} data-tags={JSON.stringify(ui.searchTags)}>
  <button class="thm srch-btn" type="button" aria-label={ui.search} title={ui.search} aria-expanded="false" aria-controls={`srch-panel`}>
    <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
  </button>
  <div class="srch-panel" id="srch-panel" role="dialog" aria-label={ui.search} hidden>
    <label class="srch-field">
      <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
      <span class="skip">{ui.search}</span>
      <input type="search" enterkeyhint="search" autocomplete="off" spellcheck="false" placeholder={ui.searchPh} role="combobox" aria-expanded="false" aria-controls="srch-list" aria-autocomplete="list" />
      <kbd aria-hidden="true">Esc</kbd>
    </label>
    <ul class="srch-list" id="srch-list" role="listbox"></ul>
  </div>
</div>

<script>
  type Entry = { t: string; d: string; u: string; k: string; g: string };
  const GROUPS = ['page', 'feature', 'faq', 'legal'];
  // Büyük/küçük harf, aksan ve Türkçe ı/İ farkını yok say.
  const norm = (s: string) => s.toLocaleLowerCase('tr').replace(/ı/g, 'i').normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[’'`´]/g, '');
  document.querySelectorAll<HTMLElement>('[data-search]').forEach(root => {
    const btn = root.querySelector<HTMLButtonElement>('.srch-btn')!;
    const panel = root.querySelector<HTMLElement>('.srch-panel')!;
    const input = root.querySelector<HTMLInputElement>('input')!;
    const list = root.querySelector<HTMLUListElement>('.srch-list')!;
    const tags: string[] = JSON.parse(root.dataset.tags || '[]');
    let index: (Entry & { nt: string; nk: string })[] | null = null;
    let active = -1;
    const load = async () => {
      if (index) return;
      try {
        const res = await fetch(`/${root.dataset.code}/search.json`);
        const data: Entry[] = await res.json();
        index = data.map(e => ({ ...e, nt: norm(e.t), nk: norm(`${e.t} ${e.d} ${e.k}`) }));
      } catch (e) { index = []; }
    };
    const render = () => {
      const q = norm(input.value.trim());
      list.replaceChildren();
      active = -1;
      if (!q || !index) { input.setAttribute('aria-expanded', 'false'); return; }
      const words = q.split(/\s+/).filter(Boolean);
      const hits = index
        .filter(e => words.every(w => e.nk.includes(w)))
        .map(e => ({ e, s: (e.nt.includes(q) ? 10 : 0) + words.filter(w => e.nt.includes(w)).length * 3 + (e.g === 'page' ? 2 : 0) }))
        .sort((a, b) => b.s - a.s)
        .filter((h, i, all) => all.findIndex(o => o.e.u === h.e.u && o.e.t === h.e.t) === i)
        .slice(0, 8);
      if (!hits.length) {
        const li = document.createElement('li');
        li.className = 'srch-none';
        li.textContent = root.dataset.none || '';
        list.append(li);
      }
      hits.forEach(({ e }, i) => {
        const li = document.createElement('li');
        li.setAttribute('role', 'option');
        li.id = `srch-o${i}`;
        const a = document.createElement('a');
        a.href = e.u;
        const tag = document.createElement('small');
        tag.textContent = tags[GROUPS.indexOf(e.g)] || '';
        const b = document.createElement('b');
        b.textContent = e.t;
        const p = document.createElement('span');
        p.textContent = e.d;
        a.append(tag, b, p);
        a.addEventListener('click', () => {
          (window as any).maTrack?.('search_select', { search_term: input.value.trim(), url: e.u });
          close();
        });
        li.append(a);
        list.append(li);
      });
      input.setAttribute('aria-expanded', 'true');
    };
    const move = (step: number) => {
      const items = [...list.querySelectorAll<HTMLElement>('[role=option]')];
      if (!items.length) return;
      active = (active + step + items.length) % items.length;
      items.forEach((el, i) => el.classList.toggle('on', i === active));
      input.setAttribute('aria-activedescendant', items[active].id);
      items[active].scrollIntoView({ block: 'nearest' });
    };
    const open = () => {
      panel.hidden = false;
      btn.setAttribute('aria-expanded', 'true');
      input.focus();
      load().then(render);
    };
    function close() {
      panel.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
    }
    btn.addEventListener('click', () => (panel.hidden ? open() : close()));
    input.addEventListener('input', render);
    input.addEventListener('keydown', e => {
      if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
      else if (e.key === 'Enter') {
        const target = list.querySelectorAll<HTMLAnchorElement>('a')[Math.max(active, 0)];
        if (target) { e.preventDefault(); target.click(); }
      } else if (e.key === 'Escape') { close(); btn.focus(); }
    });
    document.addEventListener('keydown', e => {
      const el = e.target as HTMLElement;
      if (e.key === '/' && panel.hidden && !/INPUT|TEXTAREA|SELECT/.test(el.tagName)) { e.preventDefault(); open(); }
    });
    document.addEventListener('click', e => { if (!panel.hidden && !root.contains(e.target as Node)) close(); });
  });
</script>
