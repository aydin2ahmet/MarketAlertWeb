---
/** Bir uygulama ekranının açık ve koyu hâli (temaya göre biri görünür). */
import ProgressiveShot from '../ProgressiveShot.astro';
import { rpSize, rpSrc } from '../../lib/rp-data';
interface Props { code: string; k: string; alt: string; sizes: string }
const { code, k, alt, sizes } = Astro.props;
const l = rpSize(code, 'light', k), d = rpSize(code, 'dark', k);
---
<ProgressiveShot class="sh-l" src={rpSrc(code, 'light', k)} alt={alt} width={String(l[0])} height={String(l[1])} loading="lazy" decoding="async" sizes={sizes} />
<ProgressiveShot class="sh-d" src={rpSrc(code, 'dark', k)} alt="" width={String(d[0])} height={String(d[1])} loading="lazy" decoding="async" sizes={sizes} />
