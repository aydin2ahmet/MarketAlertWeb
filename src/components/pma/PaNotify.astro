---
/** Bildirim (O2): sunucunun gerçek push ve Telegram metinleri; metin kartın içinde satır kırar. Zilbo zıplar, Zilbe sevinir. */
import Zb from '../eth/Zb.astro';
import TgChat from '../telegram/TgChat.astro';
import { msgHtml } from '../../lib/telegram';
import { emLang, num, fill } from '../../lib/pa';
import '../../styles/pa.css';
interface Props { code: string; pa: any }
const { code, pa } = Astro.props;
const A = pa.app, E = emLang(code), N = E.num;
const c = 67120.5, m = 66910.4;
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const head = fill(A.t3, { 0: 'BTC', 1: 'EMA 200' });
const tg = { text: `🟢 <b>${esc(head)}</b>\n<i>🔔 ${esc(pa.alarmName)}</i>\n<blockquote>${esc(A.close)}: <b>${num(N, c, 1)}</b>\nEMA 200: <b>${num(N, m, 1)}</b></blockquote>\n⏱ ${esc(E.tg.tf['4h'])} · ${esc(E.tg.market)}`, button: E.tg.button };
---
<section class="pa-n" data-pa-n>
  <div><h2>{pa.nTitle}</h2><p class="pa-lead">{pa.nLead}</p></div>
  <div class="pa-nw">
    <div class="pa-ps pa-psn"><img src="/icons/logo-96.png" alt="" width="34" height="34" /><div><div class="pa-ps-h"><b>MarketAlert</b><span>{pa.now}</span></div><b class="pa-ps-t" dir="auto">{fill(A.p3, { 0: 'BTC', 1: 'EMA 200' })}</b><span class="pa-ps-b pa-wrap" dir="ltr">{`↑ ${num(N, c, 1)} USDT  │  ↗ EMA(200)·4h ${num(N, m, 1)} USDT  ✓`}</span></div></div>
    <TgChat code={code} label={`Telegram: ${head}`} class="pa-tg"><div class="tgm" set:html={msgHtml(tg, '07:00')} /></TgChat>
    <Zb who="zilbo" class="pa-nz" /><Zb who="zilbe" class="pa-ne" />
  </div>
</section>
<script>
  import { zbPlay, zbPrime, zbReduce } from '../../lib/zb';
  for (const k of document.querySelectorAll<HTMLElement>('[data-pa-n]')) {
    zbPrime(k);
    if (zbReduce) continue;
    const io = new IntersectionObserver(es => { if (!es[0].isIntersecting) return; io.disconnect(); zbPlay(k.querySelector<HTMLElement>('.pa-nz'), 'zilbo-zipla'); setTimeout(() => zbPlay(k.querySelector<HTMLElement>('.pa-ne'), 'zilbe-sevin'), 900); }, { threshold: .4 });
    io.observe(k);
  }
</script>
