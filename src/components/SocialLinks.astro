---
import translations from '../i18n/social.json';
interface Props { code: string }
const { code } = Astro.props;
const t = translations[code as keyof typeof translations];
const channels = [
  { id: 'instagram', name: 'Instagram', url: 'https://www.instagram.com/marketalert.en/' },
  { id: 'tiktok', name: 'TikTok', url: 'https://www.tiktok.com/@marketalertapp' },
  { id: 'x', name: 'X', url: 'https://x.com/marketalert_en' },
  { id: 'youtube', name: 'YouTube', url: 'https://www.youtube.com/@marketalertapp' },
];
---
<div class="social">
  <div class="social-copy"><h2>{t.title}</h2><p>{t.note}</p></div>
  <nav class="social-links" aria-label={t.title}>
    {channels.map(channel => <a href={channel.url} target="_blank" rel="noopener noreferrer">
      <span class={`brand-logo brand-${channel.id}`} aria-hidden="true"><svg viewBox="0 0 24 24"><use href={`/icons/social.svg#${channel.id}`} /></svg></span>
      <span dir="ltr">{channel.name}</span><span class="social-arrow" aria-hidden="true">↗</span>
    </a>)}
  </nav>
</div>
<style>
  .social { display:flex; align-items:center; justify-content:space-between; gap:26px; margin:26px 0 25px; }
  .social-copy { flex:1; min-width:0; }
  .social-copy h2 { margin:0; font-size:16px; line-height:1.4; font-weight:700; }
  .social-copy p { margin:5px 0 0; color:var(--mut); font-size:12px; line-height:1.6; }
  .social-links { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px; width:69%; max-width:720px; }
  .social-links a { display:flex; align-items:center; gap:8px; padding:13px 12px; border:1px solid var(--bd); border-radius:12px; background:var(--sf); color:var(--tx); font-size:13px; font-weight:600; text-decoration:none; transition:border-color .15s,background .15s,transform .15s; }
  .social-links a:hover { border-color:var(--pri); background:var(--priSoft); transform:translateY(-2px); }
  .social-links a:focus-visible { outline:2px solid var(--pri); outline-offset:3px; }
  .social-arrow { margin-inline-start:auto; color:var(--mut); font-size:15px; }
  .brand-logo { display:grid; place-items:center; width:32px; height:32px; border-radius:9px; flex:none; overflow:hidden; }
  .brand-logo svg { width:20px; height:20px; fill:currentColor; }
  .brand-instagram { background:radial-gradient(circle at 30% 105%,#ffd776 0%,#f58529 24%,#dd2a7b 52%,#8134af 75%,#515bd4 100%); color:#fff; }
  .brand-tiktok,.brand-x { background:#08090b; color:#fff; outline:1px solid var(--bd); }
  .brand-tiktok svg { filter:drop-shadow(-.65px -.5px 0 #25f4ee) drop-shadow(.65px .5px 0 #fe2c55); }
  .brand-youtube { background:#fff; color:#f03; }
  .brand-youtube svg { width:26px; height:26px; }
  @media(max-width:900px) {
    .social { display:block; }
    .social-links { width:100%; max-width:none; margin-top:16px; grid-template-columns:repeat(2,minmax(0,1fr)); }
    .brand-logo { width:30px; height:30px; }
    .brand-logo svg { width:19px; height:19px; }
    .brand-youtube svg { width:24px; height:24px; }
  }
  @media(prefers-reduced-motion:reduce) { .social-links a { transition:none; } }
</style>
