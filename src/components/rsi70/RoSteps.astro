---
/**
 * Kurulum (R3): üç saat kadranı, akrep 3 → 2 → 1'e doğru iner; her adımın altında gerçek ekran.
 * Zilba ayar adımında el sallar, Zilbe son adımda sevinir.
 */
import Zb from '../eth/Zb.astro';
import RoShot from './RoShot.astro';
import '../../styles/ro.css';
interface Props { code: string; ro: any; steps: string[][]; html: string[] }
const { code, ro, steps, html } = Astro.props;
const shots = ['gal', 'os', 'det'];
---
<div class="ro-c" data-ro-c>
  <ol>{steps.map((s, i) => <li>
    <div class="ro-face" aria-hidden="true"><i style={`transform:rotate(${[90, 60, 30][i]}deg)`}></i><b>{3 - i}</b></div>
    <h3>{s[0]}</h3><p set:html={html[i]} />
    <div class="ro-rise"><div class="ro-ph"><RoShot code={code} k={shots[i]} alt={ro.stepAlts[i]} sizes="240px" /></div>{i === 1 && <Zb who="zilba" />}{i === 2 && <Zb who="zilbe" />}</div>
  </li>)}</ol>
</div>

<script>
  import { zbPlay, zbPrime, zbReduce } from '../../lib/zb';
  for (const k of document.querySelectorAll<HTMLElement>('[data-ro-c]')) {
    zbPrime(k);
    if (zbReduce) continue;
    k.classList.add('ro-js');
    for (const r of k.querySelectorAll<HTMLElement>('.ro-rise')) {
      const io = new IntersectionObserver(es => { if (!es[0].isIntersecting) return; io.disconnect(); r.classList.add('in'); const z = r.querySelector<HTMLElement>('.zb'); if (z) setTimeout(() => zbPlay(z, z.dataset.who === 'zilbe' ? 'zilbe-sevin' : 'zilba-el'), 700); }, { threshold: .25 });
      io.observe(r);
    }
  }
</script>
