---
/** Bildirim (R3): gerçek push metni ve bildirim detayı ekranı; saat çalınca Zilbo zil çalar, Zilbe ekranın yanında. */
import Zb from '../eth/Zb.astro';
import RoShot from './RoShot.astro';
import { roNum, fill } from '../../lib/ro';
import '../../styles/ro.css';
interface Props { code: string; ro: any; caption: string }
const { code, ro, caption } = Astro.props;
---
<section class="ro-n" data-ro-n>
  <div class="ro-nt">
    <h2>{ro.nTitle}</h2><p class="ro-lead">{ro.nLead}</p>
    <div class="ro-ps"><img src="/icons/logo-96.png" alt="" width="34" height="34" /><div><div class="ro-ps-h"><b>MarketAlert</b><span>{ro.now}</span></div><b class="ro-ps-t">{fill(ro.app.pushBelow, { 0: 'BTC', 1: 30 })}</b><span class="ro-ps-b" dir="ltr">{`RSI(14)·1h  ${roNum(ro.nf, 28.4)}  │  < 30  ✓`}</span></div></div>
    <Zb who="zilbo" class="ro-nz" />
  </div>
  <figure><div class="ro-ph"><RoShot code={code} k="ntf" alt={ro.ntfAlt} sizes="260px" /></div><Zb who="zilbe" class="ro-ne" /><figcaption>{caption}</figcaption></figure>
</section>

<script>
  import { zbPlay, zbPrime, zbReduce } from '../../lib/zb';
  for (const k of document.querySelectorAll<HTMLElement>('[data-ro-n]')) {
    zbPrime(k);
    if (zbReduce) continue;
    const io = new IntersectionObserver(es => { if (!es[0].isIntersecting) return; io.disconnect(); zbPlay(k.querySelector<HTMLElement>('.ro-nz'), 'zilbo-zil'); setTimeout(() => zbPlay(k.querySelector<HTMLElement>('.ro-ne'), 'zilbe-sevin'), 900); }, { threshold: .4 });
    io.observe(k);
  }
</script>
