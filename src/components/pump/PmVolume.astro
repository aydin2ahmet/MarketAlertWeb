---
/**
 * Pump mu, Pump + hacim mi (P3): küçük radar, noktanın gölgesi hacimdir. İki coin halkayı geçer; Pump + hacim
 * seçiliyken gölgesi küçük olan (hacmi ortalamanın 3 katından az) sayılmaz, Zilba söyler. Düğmeler şablon adlarıdır.
 * JS yoksa ya da hareket azaltma açıksa son hâl (Pump + hacim) durur.
 */
import Zb from '../eth/Zb.astro';
import { fill, pmPct } from '../../lib/pm';
import '../../styles/pm.css';
interface Props { pm: any; title: string }
const { pm, title } = Astro.props;
const nf = pm.nf;
const nx = (v: number) => new Intl.NumberFormat(nf, { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(v);
// [coin, yüzde, hacim katı, açı]
const V: [string, number, number, number][] = [['PEPE', 6.0, 1.1, 126], ['SOL', 8.4, 3.6, 235], ['LINK', 2.1, .9, 52], ['AVAX', 6.1, 3.2, 304]];
const lbl = (c: string, v: number, h: number) => v >= 5 ? `${c} ${pmPct(nf, v, true)} · ${nx(h)}×` : c;
---
<section class="pm-v" aria-labelledby="pm-v-t">
  <div>
    <h2 id="pm-v-t">{title}</h2><p class="pm-lead">{pm.vLead}</p>
    <div class="pm-seg" data-pm-seg><button type="button" aria-pressed="false" data-m="0">{pm.app.pump}</button><button type="button" aria-pressed="true" data-m="1">{pm.app.pumpVol}</button></div>
    <p class="pm-note">{pm.halo}</p>
  </div>
  <div class="pm-vs" data-pm-v role="img" aria-label={pm.volAlt} data-v={JSON.stringify(V.map(([c, v, h, a]) => [c, v, h, a, lbl(c, v, h)]))} data-say={pm.sayNo}>
    <div class="pm-mask" aria-hidden="true"><div class="pm-rd" style="--t:120">
      <div class="pm-sw"></div>
      {[70, 130, 190, 250].map(x => <div class="pm-ring" style={`--r:${x}`}></div>)}
      <div class="pm-thr"><i dir="ltr">{`${pmPct(nf, 5, true, 0)} · ${fill(pm.app.min, { count: 5 })}`}</i></div>
      {V.map(([c, v, h, a]) => { const ok = v >= 5 && h >= 3; return <div class={`pm-dot${ok ? ' hit' : v >= 5 ? ' nov' : ''}${Math.cos(a * Math.PI / 180) < -.2 ? ' lft' : ''}`} style={`--a:${a}deg;--r:${50 + v * 12};--h:${Math.round(h * 16)}px`}><span class="pm-halo"></span><b dir="ltr">{lbl(c, v, h)}</b></div>; })}
    </div></div>
    <Zb who="zilba" /><p class="pm-say" aria-hidden="true"></p>
  </div>
</section>

<script>
  import { zbPlay, zbPrime, zbReduce, sleep, watchVisible } from '../../lib/zb';
  for (const k of document.querySelectorAll<HTMLElement>('[data-pm-v]')) {
    const seg = k.parentElement!.querySelector<HTMLElement>('[data-pm-seg]')!;
    let mode = 1;
    const V: [string, number, number, number, string][] = JSON.parse(k.dataset.v!);
    const dots = [...k.querySelectorAll<HTMLElement>('.pm-dot')];
    const paint = (on: boolean) => dots.forEach((d, i) => { const [c, v, h, , l] = V[i]; const ok = v >= 5 && (mode === 0 || h >= 3); d.style.setProperty('--r', String(on ? 50 + v * 12 : 30)); d.classList.toggle('hit', on && ok); d.classList.toggle('nov', on && v >= 5 && !ok); d.querySelector('b')!.textContent = on ? l : c; });
    seg.querySelectorAll<HTMLButtonElement>('button').forEach(b => b.addEventListener('click', () => { mode = +b.dataset.m!; seg.querySelectorAll('button').forEach(x => x.setAttribute('aria-pressed', String(x === b))); paint(true); }));
    zbPrime(k);
    if (zbReduce) continue;
    k.classList.add('pm-js'); k.querySelector('.pm-mask')!.classList.add('pm-js');
    const za = k.querySelector<HTMLElement>('.zb'), say = k.querySelector<HTMLElement>('.pm-say')!;
    const wait = watchVisible(k, .35);
    (async () => {
      while (true) {
        await wait();
        paint(false); await sleep(1600); paint(true); await sleep(1700);
        if (mode === 1) { const bad = V.find(x => x[1] >= 5 && x[2] < 3)!; say.textContent = k.dataset.say!.replace('{coin}', bad[0]); say.classList.add('on'); zbPlay(za, 'zilba-sasir'); await sleep(2400); say.classList.remove('on'); }
        else { zbPlay(za, 'zilba-el'); await sleep(2400); }
        await sleep(1400);
      }
    })();
  }
</script>
