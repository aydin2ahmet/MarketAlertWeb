---
/**
 * "Sesle neler yapabilirsin?" kutusu, tasarım E1 (2026-11-09): dört ikonlu kart (kur, değiştir,
 * listele, sil) ve örnek cümleleri. Sesli asistan alarm siler (Ahmet 2026-11-09); hedef belli
 * değilse önce sorar.
 */
interface Props { title: string; items: string[][]; note: string }
const { title, items, note } = Astro.props;
const ICONS = [
  '<path d="M12 5v14M5 12h14"/>',
  '<path d="M4 20h4L19 9l-4-4L4 16z"/>',
  '<path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"/>',
  '<path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/>',
];
---
<section class="va" aria-labelledby="va-t">
  <h2 id="va-t">{title}</h2>
  <div class="va-tiles">
    {items.map((it, i) => (
      <div class={`va-t va${i}`}>
        <span class="va-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[i]} /></span>
        <h3>{it[0]}</h3>
        <q>{it[1]}</q>
      </div>
    ))}
  </div>
  <p class="va-note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" /></svg>{note}</p>
</section>

<style>
  .va { padding: 56px 0; border-bottom: 1px solid var(--bd); }
  .va h2 { font-size: clamp(24px, 3vw, 32px); margin-bottom: 18px; text-wrap: balance; }
  @media (max-width: 760px) { .va { padding: 40px 0; } }
  .va-tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .va-t { background: var(--sf); border: 1px solid var(--bd); border-radius: 16px; padding: 20px; display: flex; flex-direction: column; gap: 10px; }
  .va-ic { width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; color: var(--c); background: color-mix(in srgb, var(--c) 14%, transparent); }
  .va-ic svg { width: 22px; height: 22px; }
  .va0 { --c: var(--cat1); } .va1 { --c: var(--cat3); } .va2 { --c: var(--cat2); } .va3 { --c: var(--cat6); }
  .va-t h3 { margin: 0; font-size: 18px; }
  .va-t q { color: var(--mut); font-size: 15px; }
  .va-note { display: flex; gap: 8px; align-items: center; margin-top: 16px; color: var(--mut); font-size: 15px; }
  .va-note svg { width: 18px; height: 18px; flex: none; }
  @media (max-width: 760px) { .va-tiles { grid-template-columns: 1fr 1fr; } .va-t { padding: 16px; } .va-note { align-items: flex-start; } }
</style>
