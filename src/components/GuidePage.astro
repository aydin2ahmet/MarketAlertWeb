---
import ZilboHook from './ZilboHook.astro';
import StoreBadges from './StoreBadges.astro';
import SearchBox from './SearchBox.astro';
import SocialLinks from './SocialLinks.astro';
import Base from '../layouts/Base.astro';
import ProgressiveShot from './ProgressiveShot.astro';
import StepArc from './StepArc.astro';
import content from '../i18n/content.json';
import guides from '../i18n/alert-guides.json';
import { SECTIONS, linkify, pageLink, plain } from '../lib/pages';
import rsiGuides from '../i18n/rsi-alerts.json';
import screenSizes from '../i18n/rsi-screens.json';
import { GA_ID, LOCALES, SITE, legalUrl } from '../config';

interface Props { locale: any; section: 'features' | 'coins'; slug: string }
const { locale, section, slug } = Astro.props;
const code = locale.code;
const t = (content as any)[code];
const g = SECTIONS[section][code][slug];
const L = (text: string) => linkify(text, code);
const r = (rsiGuides as any)[code];
// Rehber başına görsel ve kod satırları. Yeni rehber eklerken buraya da bir kayıt ekle.
const VISUAL: Record<string, { kicker: string; exampleKicker: string; condition: string[]; foot: string; shot: string; version: string; width: number; height: number | null; logic?: string[][]; hook?: { pair: string; market: string; from: number; target: number; touch: number; last: number; op: '<' | '>'; unit?: 'pct' }; stepShots?: [string, number][] }> = {
  'features/price-alerts': { kicker: 'BINANCE · PRICE · PUSH', exampleKicker: 'BTC/USDT · 70,000 · ONCE', condition: ['BTC/USDT', '≥', '70,000 USDT'], foot: 'BINANCE SPOT · USDT · ONCE → PUSH', shot: 'price', version: 'price1', width: 1080, height: 2280,
    logic: [['HIGH 69,990 · LAST 69,880', '→ ✕'], ['HIGH 70,012 · LAST 69,880', 'TOUCH → ✓']] },
  'features/volume-spike-alerts': { kicker: 'BINANCE · VOLUME / SMA · TELEGRAM', exampleKicker: '15m · SMA(20) · 3×', condition: ['VOLUME', '>', '3 × SMA(20)'], foot: 'BINANCE SPOT · USDT · TOP 100 → TELEGRAM', shot: 'rsi/volume-result', version: 'volume1', width: 390, height: null },
  'features/percent-change-alerts': { kicker: 'BINANCE · % MOVE · PUSH', exampleKicker: 'SOL/USDT · 15m · +3% · ONCE', condition: ['Δ% (15m)', '≥', '+3%'], foot: 'BINANCE SPOT · USDT · ONCE → PUSH', shot: 'tpl', version: 'pct1', width: 1080, height: 2280,
    logic: [['15m Δ +1.8%', '→ ✕'], ['15m Δ +3.2%', '≥ +3% → ✓']],
    hook: { pair: 'SOL/USDT · 15m', market: 'BINANCE SPOT', from: 0.4, target: 3, touch: 3.2, last: 3.2, op: '>', unit: 'pct' } },
  'features/all-coins-alerts': { kicker: 'BINANCE · ALL COINS · TOP 100', exampleKicker: 'SPOT USDT · TOP 100 · 5m', condition: ['Δ% (5m) ≥ +5%', 'AND', 'VOL > 3 × SMA(20)'], foot: 'EACH COIN CHECKED ON ITS OWN → PUSH · TELEGRAM', shot: 'hero-list', version: 'all1', width: 1080, height: 2821,
    logic: [['AVAX  Δ +5.4% · VOL 3.6×', 'AND → ✓'], ['DOT   Δ +5.1% · VOL 1.2×', 'AND → ✕'], ['LINK  Δ +2.0% · VOL 4.1×', 'AND → ✕']],
    hook: { pair: 'TOP 100 · 5m', market: 'BINANCE SPOT', from: 0.8, target: 5, touch: 5.4, last: 5.4, op: '>', unit: 'pct' },
    // Adım kartlarındaki gerçek uygulama ekranları (UI kataloğu: AFRM-01-S35, AFRM-01-S22, AFRM-02-S11, PUSH-08-S01), 1080 genişlikte kırpılmış yükseklik.
    stepShots: [['step-mkt', 1107], ['step-all', 987], ['step-cond', 1134], ['step-pace', 1275]] },
  'features/multi-condition-alerts': { kicker: 'BINANCE · RSI + EMA · TELEGRAM', exampleKicker: '1h · RSI(14) · EMA(20)', condition: ['RSI(14) < 30', 'AND', 'PRICE > EMA(20)'], foot: 'BINANCE SPOT · USDT · TOP 100 → TELEGRAM', shot: 'rsi/desktop-voice-result', version: '3x-conditions2', width: 390, height: null,
    logic: [['RSI = 28 · PRICE < EMA20', 'AND → ✕'], ['RSI = 28 · PRICE > EMA20', 'AND → ✓']] },
  'coins/bitcoin-price-alert': { kicker: 'BTC/USDT · SPOT · PUSH', exampleKicker: 'BTC/USDT · 85,000 · ONCE', condition: ['BTC/USDT', '<', '85,000 USDT'], foot: 'BINANCE SPOT · USDT · ONCE → PUSH', shot: 'log', version: 'btc1', width: 1080, height: 2280,
    logic: [['LOW 85,010 · LAST 85,120', '→ ✕'], ['LOW 84,980 · LAST 84,995', 'TOUCH → ✓']],
    hook: { pair: 'BTC/USDT', market: 'BINANCE SPOT', from: 85420, target: 85000, touch: 84980, last: 84995, op: '<' } },
};
const v = VISUAL[`${section}/${slug}`];
const shotKind = v.shot.split('/').pop() as string;
const shotHeight = (theme: 'light' | 'dark') => v.height ? Math.round(390 * v.height / v.width) : (screenSizes as any)[code][theme][shotKind];
const plans: string[][] = g.plans || r.plans;
const setupTitle = ({ tr: 'Adım adım kurulum', en: 'Step-by-step setup', de: 'Schrittweise Einrichtung', fr: 'Configuration pas à pas', es: 'Configuración paso a paso', 'pt-br': 'Configuração passo a passo', ru: 'Пошаговая настройка', ja: '設定の手順', zh: '分步设置', hi: 'चरण-दर-चरण सेटअप', ar: 'الإعداد خطوة بخطوة' } as Record<string, string>)[code];
const path = `/${code}/${section}/${slug}/`;
const alternates = LOCALES.map(l => ({ hreflang: l.hreflang, href: `/${l.code}/${section}/${slug}/` }));
// İlgili sayfalar: rehberde elle seçilmiş liste (related) varsa o, yoksa diğer özellik rehberleri.
const relatedPaths: string[] = g.related || ['features/rsi-alerts', ...Object.keys((guides as any)[code]).map(s => `features/${s}`)].filter(p => p !== `${section}/${slug}`);
const related = relatedPaths.map(p => ({ href: `/${code}/${p}/`, link: pageLink(code, p) })).filter(x => x.link);
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: g.title, description: g.description, url: SITE + path, inLanguage: locale.hreflang },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'MarketAlert', item: `${SITE}/${code}/` },
    { '@type': 'ListItem', position: 2, name: g.link, item: SITE + path },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: locale.hreflang, mainEntity: g.faq.map((q: string[]) => ({ '@type': 'Question', name: q[0], acceptedAnswer: { '@type': 'Answer', text: plain(q[1]) } })) },
];
---
<Base lang={code === 'pt-br' ? 'pt-BR' : code} dir={locale.dir} title={g.title} description={g.description} path={path} ogImage={`/og/${code}.png`} jsonLd={jsonLd} alternates={alternates}>
  <a class="skip" href="#setup">{setupTitle}</a>
  <header class="hd">
    <a class="logo" href={`/${code}/`}><img src="/icons/logo-96.png" alt="" width="32" height="32" /><b>MarketAlert</b></a>
    <nav aria-label="MarketAlert"><a href={`/${code}/#features`}>{t.nav[0]}</a><a href="#plans">{t.nav[2]}</a><a href="#faq">{t.nav[3]}</a></nav>
    <div class="hx">
      <SearchBox code={code} />
      <label class="lsel"><span class="skip">{t.ui.lang}</span><select id="lang" aria-label={t.ui.lang}>{LOCALES.map(l => <option value={l.code} selected={l.code === code} lang={l.hreflang}>{l.name}</option>)}</select></label>
      <button class="thm" id="theme" type="button" aria-label={t.ui.theme} title={t.ui.theme}>
        <svg class="ic i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 14.5A8 8 0 019.5 4 8 8 0 1020 14.5z" /></svg>
        <svg class="ic i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
      <a class="btn" href={`/${code}/#download`} data-ev="cta_click">{t.download}</a>
    </div>
  </header>
  <main class="alert-guide">
    <nav class="breadcrumbs" aria-label="MarketAlert"><a href={`/${code}/`}>MarketAlert</a><span aria-hidden="true"> / </span><span>{g.link}</span></nav>
    <section class={v.hook && g.hook ? 'guide-hero has-hook' : 'guide-hero'}>
      <div class="gh-head"><p class="kicker">{v.kicker}</p><h1>{g.h1}</h1></div>
      {v.hook && g.hook && <ZilboHook code={code} hook={v.hook} text={g.hook} />}
      <div class="gh-body"><p class="intro" set:html={L(g.intro)} />
      <a class="btn" href="#setup">{setupTitle} <span aria-hidden="true">↓</span></a></div>
    </section>
    <section class="example" aria-labelledby="example-title">
      <div class="example-copy"><p class="kicker">{v.exampleKicker}</p><h2 id="example-title">{g.exampleTitle || r.exampleTitle}</h2>
        <blockquote><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3" /><path d="M5 10v2a7 7 0 0014 0v-2M12 19v3M8 22h8" /></svg><p>{g.prompt}</p></blockquote>
        <div class="condition" dir="ltr">{v.condition.map((part, i) => i % 2 ? <b>{part}</b> : <span>{part}</span>)}</div>
        <p class="example-foot" dir="ltr">{v.foot}</p>
      </div>
      <figure>
        <div class="result-screen">
          <ProgressiveShot class="sh-l" src={`/shots/${code}/light/${v.shot}.webp?v=${v.version}`} alt={g.caption} width="390" height={shotHeight('light')} loading="lazy" decoding="async" />
          <ProgressiveShot class="sh-d" src={`/shots/${code}/dark/${v.shot}.webp?v=${v.version}`} alt="" width="390" height={shotHeight('dark')} loading="lazy" decoding="async" />
        </div>
        <figcaption>{g.caption}</figcaption>
      </figure>
    </section>
    <section id="setup" class="guide-section"><p class="kicker">01 → 04</p><h2>{setupTitle}</h2>{v.stepShots && g.stepActions ? <>
      <StepArc code={code} titles={g.steps.map((s: string[]) => s[0])} actions={g.stepActions} ready={g.ready} shots={v.stepShots} version={v.version} />
      <ol class="step-notes">{g.steps.map((step: string[], i: number) => <li><span class="step-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><div><h3>{step[0]}</h3><p set:html={L(step[1])} /></div></li>)}</ol>
    </> : <ol class="steps">{g.steps.map((step: string[], i: number) => <li><span class="step-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><div><h3>{step[0]}</h3><p set:html={L(step[1])} /></div></li>)}</ol>}</section>
    <section class="guide-section explain">{g.details.map((section: string[]) => <article><h2>{section[0]}</h2><p set:html={L(section[1])} /></article>)}</section>
    {v.logic && <div class="logic-example" aria-label={g.details[0][0]} dir="ltr">{v.logic.map(row => <><code>{row[0]}</code><strong>{row[1]}</strong></>)}</div>}
    <section id="plans" class="guide-section"><h2>{r.plansTitle}</h2><div class="guide-plans">{plans.map((p: string[]) => <article><h3>{p[0]}</h3><p>{p[1]}</p></article>)}</div><a class="text-link" href={`/${code}/#plans`}>{r.plansLink} ↗</a></section>
    <section id="faq" class="guide-section"><h2>{t.faqTitle}</h2><div class="faq">{g.faq.map((q: string[], i: number) => <details open={i === 0}><summary>{q[0]}</summary><p set:html={L(q[1])} /></details>)}</div></section>
    <nav class="related" aria-label={t.nav[0]}>{related.map(page => <a href={page.href}>{page.link}<span aria-hidden="true">↗</span></a>)}</nav>
    <section class="guide-cta"><h2>{r.ctaTitle}</h2><p>{r.cta}</p><StoreBadges code={code} class="cta-stores" /><a class="text-link" href={`/${code}/`}>{r.home} ↗</a></section>
  </main>
  <footer class="ft"><div class="ftop"><a class="logo" href={`/${code}/`}><img src="/icons/logo-96.png" alt="" width="32" height="32" /><b>MarketAlert</b></a><nav class="legal"><a href={legalUrl('privacy', code)}>{t.legal[0]}</a><a href={legalUrl('terms', code)}>{t.legal[1]}</a>{GA_ID && <button type="button" class="lnk" data-consent-open>{t.consent.prefs}</button>}</nav></div><div class="ft-stores"><b>{t.download}</b><StoreBadges code={code} size="sm" /></div><SocialLinks code={code} /><nav class="langs" aria-label={t.ui.lang}>{LOCALES.map(l => <a href={`/${l.code}/${section}/${slug}/`} hreflang={l.hreflang} lang={l.hreflang} aria-current={l.code === code ? 'page' : undefined} data-ev="language_switch" data-to={l.code}>{l.name}</a>)}</nav><p class="disc">{t.disclaimer}</p><p class="copy">© 2026 MarketAlert · marketalertapp.com</p></footer>
  <script>
    const root = document.documentElement;
    document.getElementById('theme')?.addEventListener('click', () => {
      const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      root.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('theme', root.dataset.theme); } catch (e) { /* depolama kapalı olabilir */ }
      (window as any).maTrack?.('theme_toggle', { theme: root.dataset.theme });
    });
    document.getElementById('lang')?.addEventListener('change', e => {
      const code = (e.target as HTMLSelectElement).value;
      (window as any).maTrack?.('language_switch', { to_lang: code });
      location.href = location.pathname.replace(/^\/[^/]+/, '/' + code) + location.hash;
    });
  </script>
</Base>

<style>
  .alert-guide { max-width: 1200px; padding: 28px 20px 0; margin-inline: auto; }
  .skip:not(:focus) { position: fixed; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); }
  .breadcrumbs { display: flex; flex-wrap: wrap; gap: 8px; color: var(--mut); font-size: 13px; }
  .guide-hero { padding: 56px 0 48px; max-width: 940px; }
  .kicker { font: 600 12px/1.6 var(--mono); color: var(--cat3); margin-bottom: 16px; }
  h1 { font-size: clamp(34px, 4.2vw, 56px); text-wrap: balance; }
  .intro { color: var(--mut); font-size: 19px; max-width: 850px; margin: 24px 0; }
  h2 { font-size: clamp(24px, 3vw, 32px); margin-bottom: 18px; text-wrap: balance; }
  h3 { font-size: 18px; margin-bottom: 8px; }
  .example { display: grid; grid-template-columns: 1.3fr 1fr; align-items: center; gap: 40px; padding: 36px; border: 1px solid var(--bd); border-radius: 24px; background: radial-gradient(ellipse at top right, var(--priSoft), transparent 70%), var(--sf); }
  blockquote { display: flex; gap: 12px; padding: 20px; margin: 0; background: var(--priSoft); border-radius: 14px; font-size: 20px; font-weight: 600; }
  blockquote svg { width: 24px; height: 24px; flex: none; color: var(--pri); }
  .condition { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 24px; font: 600 13px/1.5 var(--mono); }
  .condition span { border: 1px solid var(--bd); border-radius: 10px; padding: 10px; background: var(--bg); }
  .condition b { color: var(--cat3); }
  .example-foot { font: 500 11px/1.8 var(--mono); color: var(--mut); margin-top: 18px; }
  figure { margin: 0; min-width: 0; }
  figcaption { color: var(--mut); font-size: 12px; margin-top: 16px; text-align: center; }
  .result-screen { width: min(100%, 320px); margin-inline: auto; border: 1px solid var(--bd); border-radius: 22px; overflow: hidden; box-shadow: 0 16px 50px #0002; }
  .result-screen img { width: 100%; height: auto; }
  .guide-section { padding: 56px 0; border-bottom: 1px solid var(--bd); scroll-margin-top: 90px; }
  .steps { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .steps li { display: flex; align-items: start; gap: 16px; padding: 24px; border: 1px solid var(--bd); border-radius: 16px; background: var(--sf); }
  .step-number { color: var(--pri); font: 600 24px/1.3 var(--mono); }
  .steps li > div { min-width: 0; flex: 1; }
  .step-notes { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 28px 48px; }
  .step-notes li { display: flex; align-items: start; gap: 14px; }
  .step-notes .step-number { color: var(--pri, #f5a524); font: 800 14px/1.9 ui-monospace, monospace; }
  .step-notes h3 { margin: 0 0 4px; font-size: 18px; }
  .step-notes p { margin: 0; color: var(--mut); }
  .steps p, .guide-plans p, .explain p, .guide-cta p { color: var(--mut); }
  .explain { display: grid; gap: 36px; }
  .explain p { max-width: 900px; font-size: 17px; }
  .logic-example { display: grid; grid-template-columns: 1fr auto; gap: 18px; padding: 24px; background: var(--sf); border-radius: 16px; margin-top: 24px; font-size: 14px; }
  .logic-example code { overflow-wrap: anywhere; }
  .guide-plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .guide-plans article { padding: 24px; border: 1px solid var(--bd); border-radius: 16px; background: var(--sf); }
  .text-link { display: inline-block; color: var(--cat3); margin-top: 24px; font-weight: 600; }
  .related { display: flex; flex-wrap: wrap; gap: 16px; padding-top: 32px; }
  .related a { flex: 1; min-width: min(100%, 260px); display: flex; align-items: center; justify-content: space-between; gap: 16px; border: 1px solid var(--bd); padding: 20px; border-radius: 14px; }
  .related a:hover, .breadcrumbs a:hover { color: var(--cat3); }
  .guide-cta { padding: 64px 0; text-align: center; }
  .guide-cta p { margin-bottom: 24px; }
  @media(max-width: 760px) {
    .guide-hero { padding: 32px 0; } .intro { font-size: 17px; }
    .example { grid-template-columns: 1fr; gap: 28px; padding: 20px; }
    blockquote { font-size: 17px; padding: 16px; } .result-screen { max-width: 300px; }
    .steps, .step-notes, .guide-plans { grid-template-columns: 1fr; } .steps li { padding: 20px; }
    .guide-section { padding: 40px 0; } .logic-example { font-size: 11px; gap: 16px 8px; padding: 16px; }
  }
</style>
