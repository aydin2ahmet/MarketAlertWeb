---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/noto-sans-arabic';
import '@fontsource-variable/noto-sans-devanagari';
import '../styles/site.css';
import { GA_ID, LOCALES, SITE } from '../config';
import content from '../i18n/content.json';

interface Props {
  lang: string;
  dir: string;
  title: string;
  description: string;
  path: string;
  ogImage: string;
  jsonLd: object[];
  /** Dil alternatifleri; verilmezse ana sayfanın 11 dili. */
  alternates?: { hreflang: string; href: string }[];
}
const { lang, dir, title, description, path, ogImage, jsonLd, alternates } = Astro.props;
const alts = alternates ?? LOCALES.map(l => ({ hreflang: l.hreflang, href: `/${l.code}/` }));
const canonical = SITE + path;
const ogLocale = lang.replace('-', '_');
const cs = ((content as any)[lang.toLowerCase()] ?? (content as any).en).consent;
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {GA_ID && (
      <script is:inline define:vars={{ GA_ID, PAGE_LANG: lang }}>
        // Google etiketi (gtag.js) izin moduyla: ziyaretçi kabul edene kadar çerez yazılmaz, reklam izinleri hep kapalı.
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        var saved = null;
        try { saved = localStorage.getItem('consent-analytics'); } catch (e) {}
        window.gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: saved === 'granted' ? 'granted' : 'denied' });
        window.gtag('js', new Date());
        window.gtag('config', GA_ID, { page_language: PAGE_LANG });
        // Sayfa içinden olay göndermek için.
        window.maTrack = function (name, params) { window.gtag('event', name, Object.assign({ page_language: PAGE_LANG }, params || {})); };
      </script>
    )}
    {GA_ID && <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alts.map(a => <link rel="alternate" hreflang={a.hreflang} href={SITE + a.href} />)}
    {!alternates && <link rel="alternate" hreflang="x-default" href={`${SITE}/`} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FAFAF6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#07090C" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MarketAlert" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={SITE + ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map(j => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
    <noscript><style is:inline>img[data-sharp] { display: none !important; }</style></noscript>
    <script>
      const screenshots = document.querySelectorAll<HTMLImageElement>('img[data-sharp]');
      if (screenshots.length) {
        const nearby = new Set<HTMLImageElement>();
        const upgrade = (image: HTMLImageElement) => {
          const src = image.dataset.sharp;
          if (!src || image.dataset.sharpState || !image.complete || !image.naturalWidth) return;
          const style = getComputedStyle(image);
          if (!image.getClientRects().length || style.display === 'none' || style.visibility === 'hidden') return;
          if (image.closest('.screen') && !image.classList.contains('on')) return;
          image.dataset.sharpState = 'loading';
          // Give the lightweight preview a paint before starting the full image.
          requestAnimationFrame(() => requestAnimationFrame(async () => {
            const sharp = new Image();
            sharp.decoding = 'async';
            sharp.fetchPriority = image.fetchPriority === 'high' ? 'high' : 'low';
            sharp.src = src;
            try {
              await sharp.decode();
              image.src = src;
              delete image.dataset.sharp;
              image.dataset.sharpState = 'ready';
            } catch (error) {
              // Keep the preview visible if the full image cannot be fetched.
              image.dataset.sharpState = 'error';
              console.warn('Screenshot could not be loaded:', src, error);
            }
          }));
        };
        const observer = new IntersectionObserver(entries => entries.forEach(entry => {
          const image = entry.target as HTMLImageElement;
          if (entry.isIntersecting) { nearby.add(image); upgrade(image); }
          else nearby.delete(image);
        }), { rootMargin: '160px' });
        screenshots.forEach(image => {
          observer.observe(image);
          image.addEventListener('load', () => { if (nearby.has(image)) upgrade(image); });
        });
        // Theme changes, walkthrough tabs and the tour reveal different images.
        let scheduled = false;
        new MutationObserver(() => {
          if (scheduled) return;
          scheduled = true;
          requestAnimationFrame(() => {
            scheduled = false;
            nearby.forEach(upgrade);
          });
        }).observe(document.documentElement, { subtree: true, attributes: true, attributeFilter: ['class', 'hidden', 'data-theme'] });
      }
    </script>
    {GA_ID && (
      <div class="consent" id="consent" role="dialog" aria-live="polite" hidden>
        <p>{cs.msg}</p>
        <div><button type="button" class="ghost" data-consent="denied">{cs.no}</button><button type="button" class="dl" data-consent="granted">{cs.yes}</button></div>
      </div>
    )}
    {GA_ID && (
      <script is:inline define:vars={{ GA_ID }}>
        // Çerez bandı: tercih bu tarayıcıda saklanır ve Google izin moduna iletilir.
        (function () {
          var KEY = 'consent-analytics';
          var box = document.getElementById('consent');
          var choice = null;
          try { choice = localStorage.getItem(KEY); } catch (e) {}
          if (choice !== 'granted' && choice !== 'denied') box.hidden = false;
          document.addEventListener('click', function (e) {
            var c = e.target.closest('[data-consent]');
            if (c) {
              var v = c.getAttribute('data-consent');
              try { localStorage.setItem(KEY, v); } catch (err) {}
              box.hidden = true;
              window.gtag('consent', 'update', { analytics_storage: v });
              return;
            }
            if (e.target.closest('[data-consent-open]')) { box.hidden = false; return; }
            var t = e.target.closest('[data-ev]');
            if (t) window.maTrack(t.getAttribute('data-ev'), { store: t.getAttribute('data-store') || undefined, to_lang: t.getAttribute('data-to') || undefined });
          });
        })();
      </script>
    )}
  </body>
</html>
